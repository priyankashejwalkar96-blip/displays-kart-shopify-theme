<!-- ================================================ -->
<!-- CART PAGE TEMPLATE                             -->
<!-- ================================================ -->
<div class="dk-cart-page dk-container">

  <nav class="dk-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}" class="dk-breadcrumb__link">Home</a>
    <span class="dk-breadcrumb__sep" aria-hidden="true">/</span>
    <span class="dk-breadcrumb__current" aria-current="page">Cart</span>
  </nav>

  <h1 class="dk-cart-page__heading">
    <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
    Your Cart
    {%- if cart.item_count > 0 -%}
      <span class="dk-cart-page__count">{{ cart.item_count }} item{{ cart.item_count | pluralize: '', 's' }}</span>
    {%- endif -%}
  </h1>

  {%- if cart.item_count == 0 -%}
    <div class="dk-cart-page__empty">
      <i class="fa-solid fa-bag-shopping dk-cart-page__empty-icon" aria-hidden="true"></i>
      <h2>Your cart is empty</h2>
      <p>Add some amazing display products to get started!</p>
      <a href="{{ routes.collections_url }}" class="dk-btn dk-btn--primary">Continue Shopping</a>
    </div>
  {%- else -%}
    <div class="dk-cart-page__layout">

      <!-- Cart Items -->
      <div class="dk-cart-page__items">
        {%- form 'cart', cart, id: 'dk-cart-page-form', class: 'dk-cart-page-form' -%}

          <!-- Free shipping bar -->
          {%- assign free_threshold = 1000 -%}
          {%- assign cart_rupees = cart.total_price | divided_by: 100.0 -%}
          <div class="dk-cart-page__shipping-bar">
            {%- if cart_rupees >= free_threshold -%}
              <p class="dk-cart-page__shipping-msg dk-cart-page__shipping-msg--done">
                <i class="fa-solid fa-truck-fast" aria-hidden="true"></i> 🎉 You qualify for <strong>Free Shipping!</strong>
              </p>
            {%- else -%}
              {%- assign remaining = free_threshold | minus: cart_rupees -%}
              <p class="dk-cart-page__shipping-msg">
                Add <strong>₹{{ remaining | round }}</strong> more to unlock <strong>Free Shipping</strong>
              </p>
              <div class="dk-cart-drawer__shipping-track" role="progressbar">
                <div class="dk-cart-drawer__shipping-fill" style="width:{{ cart_rupees | divided_by: free_threshold | times: 100 | round }}%"></div>
              </div>
            {%- endif -%}
          </div>

          <!-- Items Table -->
          <table class="dk-cart-table" role="table" aria-label="Cart items">
            <thead>
              <tr>
                <th scope="col" colspan="2">Product</th>
                <th scope="col">Price</th>
                <th scope="col">Quantity</th>
                <th scope="col">Total</th>
                <th scope="col"><span class="dk-sr-only">Remove</span></th>
              </tr>
            </thead>
            <tbody>
              {%- for item in cart.items -%}
                <tr class="dk-cart-table__row" data-key="{{ item.key }}">
                  <td class="dk-cart-table__img-cell">
                    <a href="{{ item.url }}">
                      {%- if item.image -%}
                        <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">
                      {%- else -%}
                        <div class="dk-cart-table__img-placeholder"><i class="fa-solid fa-image" aria-hidden="true"></i></div>
                      {%- endif -%}
                    </a>
                  </td>
                  <td class="dk-cart-table__info-cell">
                    <a href="{{ item.url }}" class="dk-cart-table__title">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="dk-cart-table__variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    {%- if item.variant.sku != blank -%}
                      <p class="dk-cart-table__sku">SKU: {{ item.variant.sku }}</p>
                    {%- endif -%}
                  </td>
                  <td class="dk-cart-table__price">{{ item.price | money }}</td>
                  <td class="dk-cart-table__qty">
                    <div class="dk-qty">
                      <button type="button" class="dk-qty__btn dk-qty__btn--minus" aria-label="Decrease">-</button>
                      <input
                        type="number"
                        name="updates[]"
                        id="updates_{{ item.key }}"
                        class="dk-qty__input"
                        value="{{ item.quantity }}"
                        min="1"
                        aria-label="Quantity for {{ item.title | escape }}"
                      >
                      <button type="button" class="dk-qty__btn dk-qty__btn--plus" aria-label="Increase">+</button>
                    </div>
                  </td>
                  <td class="dk-cart-table__total">{{ item.final_line_price | money }}</td>
                  <td class="dk-cart-table__remove-cell">
                    <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" class="dk-cart-table__remove" aria-label="Remove {{ item.title | escape }}">
                      <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                    </a>
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>

          <!-- Cart Note -->
          <div class="dk-cart-note">
            <label for="dk-cart-note" class="dk-cart-note__label">Order notes (optional)</label>
            <textarea id="dk-cart-note" name="note" class="dk-cart-note__input" rows="3" placeholder="Special instructions, custom size requests, etc.">{{ cart.note }}</textarea>
          </div>

          <div class="dk-cart-page__actions">
            <button type="submit" name="update" class="dk-btn dk-btn--outline">
              <i class="fa-solid fa-rotate" aria-hidden="true"></i> Update Cart
            </button>
            <a href="{{ routes.collections_url }}" class="dk-btn dk-btn--outline">
              <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Continue Shopping
            </a>
          </div>

        {%- endform -%}
      </div>

      <!-- Order Summary -->
      <aside class="dk-cart-page__summary" aria-label="Order summary">
        <h2 class="dk-cart-page__summary-title">Order Summary</h2>

        <div class="dk-cart-summary-rows">
          <div class="dk-cart-summary-row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="dk-cart-summary-row">
            <span>Shipping</span>
            {%- if cart_rupees >= free_threshold -%}
              <span class="dk-text-green">Free</span>
            {%- else -%}
              <span>Calculated at checkout</span>
            {%- endif -%}
          </div>
          <div class="dk-cart-summary-row">
            <span>Taxes</span>
            <span>Calculated at checkout</span>
          </div>
        </div>

        <div class="dk-cart-summary-total">
          <span>Estimated Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <a href="{{ routes.checkout_url }}" class="dk-btn dk-btn--primary dk-cart-page__checkout-btn" id="dk-checkout-btn">
          <i class="fa-solid fa-lock" aria-hidden="true"></i> Proceed to Checkout
        </a>

        <div class="dk-cart-page__payment-icons" aria-label="Accepted payment methods">
          <i class="fa-brands fa-cc-visa" title="Visa" aria-hidden="true"></i>
          <i class="fa-brands fa-cc-mastercard" title="Mastercard" aria-hidden="true"></i>
          <i class="fa-brands fa-cc-amex" title="American Express" aria-hidden="true"></i>
          <span class="dk-upi-badge">UPI</span>
        </div>

        <p class="dk-cart-page__trust">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          Secure 256-bit encrypted checkout
        </p>

        <!-- WhatsApp order -->
        <div class="dk-cart-page__whatsapp">
          <p>Prefer to order via WhatsApp?</p>
          <a href="https://wa.me/917900054449?text=Hi!%20I%20want%20to%20place%20an%20order" target="_blank" rel="noopener" class="dk-btn dk-btn--whatsapp dk-btn--sm">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Order on WhatsApp
          </a>
        </div>
      </aside>

    </div><!-- /.dk-cart-page__layout -->
  {%- endif -%}
</div>

<style>
.dk-cart-page { padding: 32px 0 80px; }
.dk-cart-page__heading { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 900; margin: 16px 0 32px; display: flex; align-items: center; gap: 12px; }
.dk-cart-page__count { font-size: 16px; font-weight: 600; color: #737373; }
.dk-cart-page__empty { text-align: center; padding: 80px 20px; }
.dk-cart-page__empty-icon { font-size: 80px; color: #e5e5e5; display: block; margin-bottom: 24px; }
.dk-cart-page__layout { display: grid; grid-template-columns: 1fr; gap: 28px; }
@media (min-width: 1024px) { .dk-cart-page__layout { grid-template-columns: 1fr 380px; } }
.dk-cart-page__shipping-bar { background: #fff; border: 1px solid var(--dk-border); border-radius: 14px; padding: 14px 20px; margin-bottom: 20px; }
.dk-cart-page__shipping-msg { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
.dk-cart-page__shipping-msg--done { color: #15803d; }
.dk-cart-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid var(--dk-border); }
.dk-cart-table thead th { text-align: left; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #737373; padding: 14px 16px; background: #faf9f7; border-bottom: 1px solid var(--dk-border); }
.dk-cart-table__row { border-bottom: 1px solid var(--dk-border); }
.dk-cart-table__row:last-child { border-bottom: none; }
.dk-cart-table__img-cell { padding: 16px; width: 100px; }
.dk-cart-table__img-cell img { width: 80px; height: 80px; border-radius: 12px; object-fit: cover; border: 1px solid var(--dk-border); }
.dk-cart-table__info-cell { padding: 16px 8px; }
.dk-cart-table__title { font-size: 14px; font-weight: 700; display: block; margin-bottom: 4px; transition: color .2s; }
.dk-cart-table__title:hover { color: var(--dk-red); }
.dk-cart-table__variant, .dk-cart-table__sku { font-size: 12px; color: #a3a3a3; }
.dk-cart-table__price, .dk-cart-table__total { padding: 16px; font-size: 14px; font-weight: 700; color: var(--dk-ink); }
.dk-cart-table__total { color: var(--dk-red); }
.dk-cart-table__qty { padding: 16px 8px; }
.dk-cart-table__remove-cell { padding: 16px 8px; }
.dk-cart-table__remove { color: #a3a3a3; font-size: 14px; transition: color .2s, transform .2s; display: inline-block; }
.dk-cart-table__remove:hover { color: var(--dk-red); transform: scale(1.2); }
.dk-cart-note { margin-top: 20px; }
.dk-cart-note__label { display: block; font-size: 13px; font-weight: 700; color: #525252; margin-bottom: 8px; }
.dk-cart-note__input { width: 100%; padding: 12px 16px; border: 1.5px solid #e5e5e5; border-radius: 14px; font-size: 13px; resize: vertical; outline: none; transition: border-color .2s; }
.dk-cart-note__input:focus { border-color: var(--dk-amber); }
.dk-cart-page__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
.dk-cart-page__summary { background: #fff; border: 1px solid var(--dk-border); border-radius: 20px; padding: 28px; height: fit-content; position: sticky; top: 130px; box-shadow: var(--dk-shadow); }
.dk-cart-page__summary-title { font-size: 20px; font-weight: 900; color: var(--dk-ink); margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--dk-border); }
.dk-cart-summary-rows { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--dk-border); }
.dk-cart-summary-row { display: flex; justify-content: space-between; font-size: 14px; color: #525252; }
.dk-text-green { color: #15803d; font-weight: 700; }
.dk-cart-summary-total { display: flex; justify-content: space-between; font-size: 18px; font-weight: 900; color: var(--dk-ink); margin-bottom: 20px; }
.dk-cart-page__checkout-btn { width: 100%; margin-bottom: 16px; font-size: 15px; }
.dk-cart-page__payment-icons { display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 26px; color: #a3a3a3; margin-bottom: 12px; }
.dk-upi-badge { font-size: 11px; border: 1px solid #ccc; border-radius: 4px; padding: 2px 8px; }
.dk-cart-page__trust { font-size: 12px; color: #737373; text-align: center; margin-bottom: 20px; }
.dk-cart-page__trust i { margin-right: 5px; color: var(--dk-amber); }
.dk-cart-page__whatsapp { border-top: 1px solid var(--dk-border); padding-top: 18px; text-align: center; }
.dk-cart-page__whatsapp p { font-size: 13px; color: #737373; margin-bottom: 10px; }
</style>
