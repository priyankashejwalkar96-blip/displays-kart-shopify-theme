[
  {
    "name": "theme_info",
    "theme_name": "DisplaysKart",
    "theme_version": "1.0.0",
    "theme_author": "DisplaysKart",
    "theme_documentation_url": "https://displayskart.com",
    "theme_support_url": "https://displayskart.com/contact"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_primary", "label": "Primary (Amber)", "default": "#f59e0b" },
      { "type": "color", "id": "color_accent", "label": "Accent (Red)", "default": "#d9534f" },
      { "type": "color", "id": "color_ink", "label": "Ink (Dark)", "default": "#171717" },
      { "type": "color", "id": "color_bg", "label": "Background", "default": "#fcfbf9" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "type_header_font", "label": "Headings font", "default": "poppins_n7" },
      { "type": "font_picker", "id": "type_body_font", "label": "Body font", "default": "poppins_n4" }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      { "type": "checkbox", "id": "announcement_bar_enabled", "label": "Show announcement bar", "default": true },
      { "type": "text", "id": "announcement_text", "label": "Announcement text", "default": "Free Shipping on orders above Rs.1,000 | 5% Discount on Bulk Orders | 100% Genuine Cast Acrylic | Direct Manufacturer | Pan-India Delivery" }
    ]
  },
  {
    "name": "Header",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo image" },
      { "type": "range", "id": "logo_max_width", "label": "Logo width", "min": 50, "max": 300, "step": 10, "unit": "px", "default": 160 },
      { "type": "checkbox", "id": "sticky_header", "label": "Sticky header", "default": true }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      { "type": "text", "id": "footer_tagline", "label": "Footer tagline", "default": "India's trusted manufacturer & importer of premium acrylic display products." },
      { "type": "text", "id": "footer_phone", "label": "Phone", "default": "+91 79000 54449" },
      { "type": "text", "id": "footer_email", "label": "Email", "default": "support@displayskart.com" },
      { "type": "text", "id": "footer_address", "label": "Address", "default": "Behind Bajaj Show Room, 6th Main Rd, Kamakshi Palya, Bengaluru - 560079" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" }
    ]
  },
  {
    "name": "Product Cards",
    "settings": [
      { "type": "checkbox", "id": "product_card_quick_add", "label": "Show quick add button", "default": true },
      { "type": "checkbox", "id": "product_card_wishlist", "label": "Show wishlist button", "default": true },
      { "type": "select", "id": "product_image_ratio", "label": "Product image ratio", "options": [{ "value": "square", "label": "Square (1:1)" }, { "value": "portrait", "label": "Portrait (3:4)" }], "default": "square" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Cart type", "options": [{ "value": "page", "label": "Page" }, { "value": "drawer", "label": "Drawer" }], "default": "drawer" }
    ]
  }
]
