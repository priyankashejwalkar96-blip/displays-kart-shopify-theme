{%- comment -%}
  Renders a product card.
  Accepts: product (object), image_size (optional, default 500), compact (optional bool)
{%- endcomment -%}
{%- liquid
  assign img_size = image_size | default: 500
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif
  assign sku = product.selected_or_first_available_variant.sku
-%}
<div class="product-card bg-white rounded-xl border border-gray-200 p-4 flex flex-col justify-between" data-product-card data-product-handle="{{ product.handle }}">
  <div class="product-img-box aspect-square rounded-lg bg-gray-50 mb-4">
    <a href="{{ product.url }}" class="block w-full h-full" aria-label="{{ product.title | escape }}">
    {%- if on_sale -%}
      <span class="absolute top-2.5 left-2.5 z-10 bg-[#70b343] text-white font-bold text-xs px-2 py-0.5 rounded">-{{ pct }}%</span>
    {%- endif -%}
    {%- if product.tags contains 'featured' -%}
      <span class="absolute top-2.5 right-2.5 z-10 bg-red-600 text-white font-bold text-[9px] px-1.5 py-0.5 rounded">{{ 'products.featured' | t }}</span>
    {%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: img_size }}"
        srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 500 }} 500w, {{ product.featured_image | image_url: width: 800 }} 800w"
        sizes="(min-width:1024px) 25vw, 50vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}" class="w-full h-full object-cover" loading="lazy" width="{{ img_size }}" height="{{ img_size }}">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
    {%- endif -%}
    </a>
    <button type="button" class="dk-quick" data-quick-view data-handle="{{ product.handle }}">{{ 'products.quick_view' | t }}</button>
    <button type="button" class="dk-heart" data-wishlist-toggle data-handle="{{ product.handle }}" aria-label="{{ 'wishlist.add' | t }}"><i class="fa-regular fa-heart"></i></button>
  </div>

  <div class="text-center">
    {%- if sku != blank -%}<span class="text-[11px] text-gray-400 font-medium tracking-wider">SKU: {{ sku }}</span>{%- endif -%}
    <h3 class="text-xs font-bold text-neutral-900 mt-1.5 leading-snug hover:text-red-600 transition">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
  </div>

  <div class="text-center mt-4 pt-3 border-t border-gray-100">
    <div class="text-sm font-black text-red-600">
      {%- if on_sale -%}<s class="text-gray-400 font-semibold">{{ product.compare_at_price | money }}</s> {%- endif -%}
      {%- if product.price_varies -%}<span class="text-xs font-semibold text-gray-500">{{ 'products.from' | t }}</span> {%- endif -%}
      {{ product.price | money }}
    </div>

    {%- if product.available -%}
      {%- if product.has_only_default_variant -%}
        <form method="post" action="{{ routes.cart_add_url }}" data-ajax-add>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="w-full mt-3 bg-neutral-900 hover:bg-red-600 text-white font-bold text-xs py-2 rounded-lg transition uppercase tracking-wider">{{ 'products.add_to_cart' | t }}</button>
        </form>
      {%- else -%}
        <a href="{{ product.url }}" class="block w-full mt-3 bg-neutral-900 hover:bg-red-600 text-white font-bold text-xs py-2 rounded-lg transition uppercase tracking-wider">{{ 'products.choose_options' | t }}</a>
      {%- endif -%}
    {%- else -%}
      <span class="block w-full mt-3 bg-gray-200 text-gray-500 font-bold text-xs py-2 rounded-lg uppercase tracking-wider">{{ 'products.sold_out' | t }}</span>
    {%- endif -%}
  </div>
</div>
