<!-- ================================================ -->
<!-- CART DRAWER                                    -->
<!-- ================================================ -->
<div id="dk-cart-drawer" class="dk-cart-drawer" aria-hidden="true" role="dialog" aria-label="Shopping cart" aria-modal="true">
  <div class="dk-cart-drawer__overlay" id="dk-cart-overlay"></div>
  <div class="dk-cart-drawer__panel">

    <!-- Header -->
    <div class="dk-cart-drawer__header">
      <h2 class="dk-cart-drawer__title">
        <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
        Your Cart
        <span class="dk-cart-drawer__count" id="dk-drawer-count">{{ cart.item_count }}</span>
      </h2>
      <button class="dk-cart-drawer__close" id="dk-cart-close" aria-label="Close cart">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Free shipping progress -->
    <div class="dk-cart-drawer__shipping-bar">
      {%- assign free_shipping_threshold = 1000 -%}
      {%- assign cart_total_rupees = cart.total_price | divided_by: 100.0 -%}
      {%- if cart_total_rupees >= free_shipping_threshold -%}
        <p class="dk-cart-drawer__shipping-msg dk-cart-drawer__shipping-msg--done">
          <i class="fa-solid fa-truck-fast" aria-hidden="true"></i> You qualify for <strong>Free Shipping!</strong>
        </p>
      {%- else -%}
        {%- assign remaining = free_shipping_threshold | minus: cart_total_rupees -%}
        <p class="dk-cart-drawer__shipping-msg">
          Add <strong>&#8377;{{ remaining | round }}</strong> more for <strong>Free Shipping</strong>
        </p>
        <div class="dk-cart-drawer__shipping-track" role="progressbar" aria-valuenow="{{ cart_total_rupees }}" aria-valuemin="0" aria-valuemax="{{ free_shipping_threshold }}">
          <div class="dk-cart-drawer__shipping-fill" style="width: {{ cart_total_rupees | divided_by: free_shipping_threshold | times: 100 | round }}%;"></div>
        </div>
      {%- endif -%}
    </div>

    <!-- Cart Items -->
    <div class="dk-cart-drawer__items" id="dk-cart-items">
      {%- if cart.item_count == 0 -%}
        <div class="dk-cart-drawer__empty">
          <i class="fa-solid fa-bag-shopping dk-cart-drawer__empty-icon" aria-hidden="true"></i>
          <p>Your cart is empty</p>
          <a href="{{ routes.collections_url }}" class="dk-btn dk-btn--primary">Start Shopping</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="dk-cart-item" data-key="{{ item.key }}">
            <div class="dk-cart-item__img">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">
              {%- else -%}
                <div class="dk-cart-item__img-placeholder">
                  <i class="fa-solid fa-image" aria-hidden="true"></i>
                </div>
              {%- endif -%}
            </div>
            <div class="dk-cart-item__info">
              <a href="{{ item.url }}" class="dk-cart-item__name">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="dk-cart-item__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="dk-cart-item__bottom">
                <div class="dk-qty" data-key="{{ item.key }}">
                  <button class="dk-qty__btn dk-qty__btn--minus" aria-label="Decrease quantity">-</button>
                  <input type="number" class="dk-qty__input" value="{{ item.quantity }}" min="1" aria-label="Quantity" data-key="{{ item.key }}">
                  <button class="dk-qty__btn dk-qty__btn--plus" aria-label="Increase quantity">+</button>
                </div>
                <span class="dk-cart-item__price">{{ item.final_line_price | money }}</span>
                <button class="dk-cart-item__remove" data-key="{{ item.key }}" aria-label="Remove {{ item.title | escape }}">
                  <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Footer -->
    {%- if cart.item_count > 0 -%}
      <div class="dk-cart-drawer__footer">
        <div class="dk-cart-drawer__subtotal">
          <span>Subtotal</span>
          <span id="dk-cart-subtotal">{{ cart.total_price | money }}</span>
        </div>
        <p class="dk-cart-drawer__taxes-note">Taxes and shipping calculated at checkout</p>
        <a href="{{ routes.checkout_url }}" class="dk-btn dk-btn--primary dk-cart-drawer__checkout-btn">
          <i class="fa-solid fa-lock" aria-hidden="true"></i> Proceed to Checkout
        </a>
        <a href="{{ routes.cart_url }}" class="dk-btn dk-btn--outline dk-cart-drawer__view-btn">View Full Cart</a>
      </div>
    {%- endif -%}

  </div><!-- /.dk-cart-drawer__panel -->
</div>
