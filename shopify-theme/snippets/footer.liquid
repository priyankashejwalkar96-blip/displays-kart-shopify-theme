<!-- ================================================ -->
<!-- SITE FOOTER                                    -->
<!-- ================================================ -->
<footer id="site-footer" class="dk-footer">
  <div class="dk-footer__wrap dk-container">

    <!-- Footer CTA -->
    <div class="dk-footer__cta">
      <div class="dk-footer__cta-text">
        <h3>Stay connected with DisplaysKart!</h3>
        <p>Get exclusive deals, new arrivals & bulk pricing straight to your inbox.</p>
      </div>
      <form class="dk-footer__newsletter" action="/contact#contact_form" method="post" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="&#x2713;">
        <div class="dk-footer__newsletter-inner">
          <input
            type="email"
            name="contact[email]"
            placeholder="Your email address"
            class="dk-footer__newsletter-input"
            aria-label="Email address for newsletter"
            required
          >
          <button type="submit" class="dk-footer__newsletter-btn">
            Subscribe <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
          </button>
        </div>
      </form>
    </div>

    <!-- Footer Grid -->
    <div class="dk-footer__grid">

      <!-- Brand Column -->
      <div class="dk-footer__brand">
        <a href="{{ routes.root_url }}" class="dk-footer__logo" aria-label="{{ shop.name }} home">
          Displays <span>Kart</span>
        </a>
        <p class="dk-footer__tagline">{{ settings.footer_tagline }}</p>
        <!-- Social Links -->
        <div class="dk-footer__social">
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" class="dk-footer__social-link" aria-label="Facebook">
              <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
            </a>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" class="dk-footer__social-link" aria-label="Instagram">
              <i class="fa-brands fa-instagram" aria-hidden="true"></i>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" class="dk-footer__social-link" aria-label="YouTube">
              <i class="fa-brands fa-youtube" aria-hidden="true"></i>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" class="dk-footer__social-link" aria-label="Pinterest">
              <i class="fa-brands fa-pinterest-p" aria-hidden="true"></i>
            </a>
          {%- endif -%}
          <a href="https://wa.me/917900054449" target="_blank" rel="noopener" class="dk-footer__social-link" aria-label="WhatsApp">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="dk-footer__col">
        <h4 class="dk-footer__heading">Quick Links</h4>
        <ul class="dk-footer__links" role="list">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.collections_url }}">Shop All</a></li>
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/applications">Applications</a></li>
          <li><a href="{{ routes.blogs_url }}/news">Blog</a></li>
          <li><a href="{{ routes.contact_url }}">Contact Us</a></li>
          <li><a href="/pages/bulk-orders">Bulk Orders</a></li>
        </ul>
      </div>

      <!-- Collections -->
      <div class="dk-footer__col">
        <h4 class="dk-footer__heading">Top Collections</h4>
        <ul class="dk-footer__links" role="list">
          <li><a href="{{ routes.collections_url }}/acrylic-photo-frames">Acrylic Photo Frames</a></li>
          <li><a href="{{ routes.collections_url }}/sign-holders">Sign Holders</a></li>
          <li><a href="{{ routes.collections_url }}/suggestion-boxes">Suggestion Boxes</a></li>
          <li><a href="{{ routes.collections_url }}/hotel-supplies">Hotel Supplies</a></li>
          <li><a href="{{ routes.collections_url }}/wall-mount">Wall Mount Frames</a></li>
          <li><a href="{{ routes.collections_url }}/acrylic-sheets">Acrylic Sheets</a></li>
          <li><a href="{{ routes.collections_url }}/brochure-holders">Brochure Holders</a></li>
        </ul>
      </div>

      <!-- Policy Links -->
      <div class="dk-footer__col">
        <h4 class="dk-footer__heading">Help & Policies</h4>
        <ul class="dk-footer__links" role="list">
          <li><a href="{{ routes.root_url }}policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="{{ routes.root_url }}policies/refund-policy">Return & Refund</a></li>
          <li><a href="{{ routes.root_url }}policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="{{ routes.root_url }}policies/terms-of-service">Terms of Service</a></li>
          <li><a href="{{ routes.account_url }}">Track My Order</a></li>
          <li><a href="{{ routes.contact_url }}">Support Centre</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="dk-footer__col">
        <h4 class="dk-footer__heading">Contact Us</h4>
        <ul class="dk-footer__contact" role="list">
          <li>
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
            <a href="tel:{{ settings.footer_phone | replace: ' ', '' }}">{{ settings.footer_phone }}</a>
          </li>
          <li>
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
            <a href="https://wa.me/917900054449" target="_blank" rel="noopener">WhatsApp Us</a>
          </li>
          <li>
            <i class="fa-regular fa-envelope" aria-hidden="true"></i>
            <a href="mailto:{{ settings.footer_email }}">{{ settings.footer_email }}</a>
          </li>
          <li>
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <address>{{ settings.footer_address }}</address>
          </li>
          <li>
            <i class="fa-regular fa-clock" aria-hidden="true"></i>
            <span>Mon&ndash;Sat: 10am&ndash;7pm</span>
          </li>
        </ul>
      </div>

    </div><!-- /.dk-footer__grid -->

    <!-- Footer Bottom Bar -->
    <div class="dk-footer__bar">
      <p class="dk-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
      <div class="dk-footer__payments" aria-label="Payment methods accepted">
        <i class="fa-brands fa-cc-visa" aria-hidden="true" title="Visa"></i>
        <i class="fa-brands fa-cc-mastercard" aria-hidden="true" title="Mastercard"></i>
        <i class="fa-brands fa-cc-amex" aria-hidden="true" title="American Express"></i>
        <i class="fa-brands fa-cc-paypal" aria-hidden="true" title="PayPal"></i>
        <span class="dk-footer__upi">UPI</span>
      </div>
      <div class="dk-footer__policy-links">
        <a href="{{ routes.root_url }}policies/privacy-policy">Privacy</a>
        <a href="{{ routes.root_url }}policies/terms-of-service">Terms</a>
        <a href="{{ routes.root_url }}policies/refund-policy">Refund</a>
      </div>
    </div>

  </div><!-- /.dk-footer__wrap -->
</footer>
