<!-- ================================================ -->
<!-- ANNOUNCEMENT BAR                               -->
<!-- ================================================ -->
<div id="dk-announcement-bar" class="dk-topbar">
  <div class="dk-topbar__shimmer" aria-hidden="true"></div>

  <div class="dk-topbar__badge">
    <span>&#127991; Exclusive Offers</span>
  </div>

  <div class="dk-topbar__marquee-wrap" aria-hidden="true">
    <div class="dk-topbar__marquee">
      <span>
        <span class="dk-topbar__star">&#10022;</span> {{ settings.announcement_text }}
        &nbsp;&nbsp;&middot;&nbsp;&nbsp;
        <span class="dk-topbar__star">&#10022;</span> {{ settings.announcement_text }}
      </span>
    </div>
    <div class="dk-topbar__fade dk-topbar__fade--left" aria-hidden="true"></div>
    <div class="dk-topbar__fade dk-topbar__fade--right" aria-hidden="true"></div>
  </div>

  <button
    class="dk-topbar__close"
    id="dk-topbar-close"
    aria-label="Close announcement bar"
    title="Close"
  >&#10005;</button>
</div>
