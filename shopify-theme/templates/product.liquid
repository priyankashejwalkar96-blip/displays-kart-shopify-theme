<!-- ================================================ -->
<!-- PRODUCT PAGE TEMPLATE                          -->
<!-- ================================================ -->
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}
  {%- assign on_sale = true -%}
  {%- assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
{%- endif -%}

<div class="dk-product-page" id="page-product">

  <!-- Breadcrumb -->
  <div class="dk-container">
    <nav class="dk-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="dk-breadcrumb__link">Home</a>
      <span class="dk-breadcrumb__sep" aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}" class="dk-breadcrumb__link">{{ collection.title }}</a>
        <span class="dk-breadcrumb__sep" aria-hidden="true">/</span>
      {%- endif -%}
      <span class="dk-breadcrumb__current" aria-current="page">{{ product.title }}</span>
    </nav>
  </div>

  <!-- Product Main -->
  <div class="dk-container dk-product-page__main">
    <div class="dk-product-layout">

      <!-- Left: Gallery -->
      <div class="dk-product-gallery">
        <!-- Main Image -->
        <div class="dk-gallery__main" id="dk-gallery-main" aria-label="Product image" role="img">
          {%- if product.featured_image -%}
            <img
              id="dk-main-img"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="dk-gallery__main-img"
              width="900"
              height="900"
              loading="eager"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'dk-gallery__main-img' }}
          {%- endif -%}
          {%- if on_sale -%}
            <span class="dk-gallery__badge dk-gallery__badge--sale">-{{ discount_pct }}%</span>
          {%- endif -%}
          {%- unless product.available -%}
            <span class="dk-gallery__badge dk-gallery__badge--sold-out">Sold Out</span>
          {%- endunless -%}
        </div>

        <!-- Thumbnails -->
        {%- if product.images.size > 1 -%}
          <div class="dk-gallery__thumbs" role="list" aria-label="Product images">
            {%- for image in product.images limit: 6 -%}
              <button
                class="dk-gallery__thumb{% if forloop.first %} dk-gallery__thumb--active{% endif %}"
                data-src="{{ image | image_url: width: 900 }}"
                data-alt="{{ image.alt | default: product.title | escape }}"
                aria-label="View image {{ forloop.index }}"
                role="listitem"
              >
                <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title | escape }}" width="120" height="120" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div><!-- /.dk-product-gallery -->

      <!-- Right: Product Info -->
      <div class="dk-product-info">

        <!-- Badges -->
        <div class="dk-product-info__badges">
          {%- if on_sale -%}
            <span class="dk-badge dk-badge--sale">-{{ discount_pct }}% OFF</span>
          {%- endif -%}
          {%- if product.available -%}
            <span class="dk-badge dk-badge--stock">&#x2713; In Stock</span>
          {%- else -%}
            <span class="dk-badge dk-badge--sold-out">Sold Out</span>
          {%- endif -%}
        </div>

        <!-- Title -->
        <h1 class="dk-product-info__title">{{ product.title }}</h1>

        <!-- SKU & Rating -->
        <div class="dk-product-info__meta">
          {%- if product.metafields.custom.sku or product.variants.first.sku != blank -%}
            <span class="dk-product-info__sku">SKU: {{ product.variants.first.sku | default: product.id }}</span>
          {%- endif -%}
          <div class="dk-product-info__rating" aria-label="Rating: 4.9 out of 5">
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <span class="dk-product-info__rating-count">(4.9 &mdash; 120+ reviews)</span>
          </div>
        </div>

        <!-- Price -->
        <div class="dk-product-info__price-wrap">
          {%- if on_sale -%}
            <span class="dk-product-info__price dk-product-info__price--sale">{{ current_variant.price | money }}</span>
            <span class="dk-product-info__price dk-product-info__price--compare">{{ current_variant.compare_at_price | money }}</span>
            <span class="dk-badge dk-badge--save">Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</span>
          {%- else -%}
            <span class="dk-product-info__price">{{ current_variant.price | money }}</span>
          {%- endif -%}
        </div>

        <!-- Product Highlights -->
        <ul class="dk-product-info__highlights" aria-label="Product highlights">
          <li><i class="fa-solid fa-star" aria-hidden="true"></i> 100% Genuine Cast Acrylic — Crystal Clear Clarity</li>
          <li><i class="fa-solid fa-star" aria-hidden="true"></i> Lightweight, Shatter-Resistant &amp; Durable</li>
          <li><i class="fa-solid fa-star" aria-hidden="true"></i> Easy to assemble — No tools required</li>
          <li><i class="fa-solid fa-star" aria-hidden="true"></i> Suitable for retail, hotel, office &amp; home use</li>
        </ul>

        <!-- Variants Form -->
        {%- unless product.has_only_default_variant -%}
          <div class="dk-product-info__variants">
            {%- for option in product.options_with_values -%}
              <div class="dk-product-info__option">
                <label class="dk-product-info__option-label">{{ option.name }}</label>
                <div class="dk-product-info__option-values">
                  {%- for value in option.values -%}
                    <button
                      class="dk-option-btn{% if option.selected_value == value %} dk-option-btn--active{% endif %}"
                      data-option="{{ option.position }}"
                      data-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <!-- Add to Cart form -->
        {%- form 'product', product, id: 'dk-product-form', class: 'dk-product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="dk-variant-id">

          <!-- Quantity -->
          <div class="dk-product-info__qty-wrap">
            <label class="dk-product-info__option-label" for="dk-qty">Quantity</label>
            <div class="dk-qty">
              <button type="button" class="dk-qty__btn dk-qty__btn--minus" aria-label="Decrease quantity">&#8722;</button>
              <input type="number" name="quantity" id="dk-qty" class="dk-qty__input" value="1" min="1" aria-label="Quantity">
              <button type="button" class="dk-qty__btn dk-qty__btn--plus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="dk-product-info__ctas">
            {%- if product.available -%}
              <button type="submit" class="dk-btn dk-btn--dark dk-product-info__atc" id="dk-atc-btn">
                <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
                Add To Cart
              </button>
              <a href="/cart" class="dk-btn dk-btn--red dk-product-info__buy-now" id="dk-buy-now">
                Buy It Now
              </a>
            {%- else -%}
              <button disabled class="dk-btn dk-btn--disabled dk-product-info__atc">Sold Out</button>
            {%- endif -%}
            <button type="button" class="dk-product-info__icon-btn dk-product-info__wishlist" aria-label="Add to wishlist" title="Add to wishlist">
              <i class="fa-regular fa-heart" aria-hidden="true"></i>
            </button>
            <button type="button" class="dk-product-info__icon-btn" aria-label="Share product" title="Share" onclick="navigator.share ? navigator.share({title: '{{ product.title | escape }}', url: window.location.href}) : undefined">
              <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
            </button>
          </div>
        {%- endform -%}

        <!-- Trust badges -->
        <div class="dk-product-info__trust">
          <div class="dk-trust-item">
            <i class="fa-solid fa-lock" aria-hidden="true"></i>
            <span>Secure Checkout</span>
          </div>
          <div class="dk-trust-item">
            <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
            <span>Free Shipping &gt;&#8377;1000</span>
          </div>
          <div class="dk-trust-item">
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
            <span>Easy Returns</span>
          </div>
          <div class="dk-trust-item">
            <i class="fa-solid fa-headset" aria-hidden="true"></i>
            <span>Expert Support</span>
          </div>
        </div>

        <!-- Pincode check -->
        <div class="dk-product-info__pincheck">
          <div class="dk-pin-check">
            <input type="text" placeholder="Enter Pincode" class="dk-pin-check__input" maxlength="6" inputmode="numeric" aria-label="Enter pincode to check delivery">
            <button class="dk-btn dk-btn--dark dk-btn--sm dk-pin-check__btn" id="dk-pin-check-btn">Check</button>
          </div>
          <p class="dk-pin-check__result" id="dk-pin-result"></p>
        </div>

      </div><!-- /.dk-product-info -->
    </div><!-- /.dk-product-layout -->

    <!-- Product Tabs -->
    <div class="dk-product-tabs">
      <div class="dk-product-tabs__nav" role="tablist" aria-label="Product details">
        <button class="dk-product-tabs__tab dk-product-tabs__tab--active" role="tab" aria-selected="true" aria-controls="dk-tab-desc" id="dk-tab-btn-desc">Description</button>
        <button class="dk-product-tabs__tab" role="tab" aria-selected="false" aria-controls="dk-tab-specs" id="dk-tab-btn-specs">Specifications</button>
        <button class="dk-product-tabs__tab" role="tab" aria-selected="false" aria-controls="dk-tab-shipping" id="dk-tab-btn-shipping">Shipping</button>
        <button class="dk-product-tabs__tab" role="tab" aria-selected="false" aria-controls="dk-tab-reviews" id="dk-tab-btn-reviews">Reviews</button>
      </div>

      <div class="dk-product-tabs__panels">
        <div id="dk-tab-desc" role="tabpanel" aria-labelledby="dk-tab-btn-desc" class="dk-product-tabs__panel dk-product-tabs__panel--active">
          {%- if product.description != blank -%}
            <div class="dk-rte">{{ product.description }}</div>
          {%- else -%}
            <p>Premium acrylic display product. Lightweight, durable and crystal clear. Perfect for retail, hotel, corporate and home use.</p>
          {%- endif -%}
        </div>

        <div id="dk-tab-specs" role="tabpanel" aria-labelledby="dk-tab-btn-specs" class="dk-product-tabs__panel">
          <table class="dk-spec-table">
            <tbody>
              <tr><th>Material</th><td>100% Virgin Cast Acrylic</td></tr>
              <tr><th>Thickness</th><td>2mm – 5mm (product specific)</td></tr>
              <tr><th>Clarity</th><td>94%+ optical light transmission</td></tr>
              <tr><th>Weight</th><td>Lightweight</td></tr>
              <tr><th>Assembly</th><td>No tools required</td></tr>
              <tr><th>Country of Origin</th><td>India</td></tr>
              {%- for variant in product.variants -%}
                {%- if forloop.first -%}
                  <tr><th>SKU</th><td>{{ variant.sku | default: 'N/A' }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        <div id="dk-tab-shipping" role="tabpanel" aria-labelledby="dk-tab-btn-shipping" class="dk-product-tabs__panel">
          <ul class="dk-shipping-info">
            <li><i class="fa-solid fa-truck-fast" aria-hidden="true"></i> <strong>Free Shipping</strong> on orders above &#8377;1,000</li>
            <li><i class="fa-solid fa-box" aria-hidden="true"></i> Orders ship within <strong>1-2 business days</strong></li>
            <li><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> Pan-India delivery in <strong>3–7 days</strong></li>
            <li><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Safely packaged with bubble wrap protection</li>
            <li><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Easy returns within 48 hours if product arrives damaged</li>
          </ul>
        </div>

        <div id="dk-tab-reviews" role="tabpanel" aria-labelledby="dk-tab-btn-reviews" class="dk-product-tabs__panel">
          <div class="dk-reviews-placeholder">
            <div class="dk-reviews-summary">
              <div class="dk-reviews-summary__score">4.9 <i class="fa-solid fa-star" aria-hidden="true"></i></div>
              <p>Based on 120+ verified reviews</p>
            </div>
            <!-- Shopify native review app integration goes here -->
            <p class="dk-reviews-note">Powered by Shopify Product Reviews or your preferred review app.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    <div class="dk-related-products">
      <div class="dk-section-header">
        <h2 class="dk-section-header__title font-heading">You May Also Like</h2>
      </div>
      <div class="dk-product-grid dk-product-grid--4col">
        {%- assign related_collection = collection | default: product.collections.first -%}
        {%- if related_collection -%}
          {%- for p in related_collection.products limit: 4 -%}
            {%- unless p.id == product.id -%}
              {% render 'product-card', product: p, section_id: 'related' %}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

  </div><!-- /.dk-container -->

  <!-- Mobile Sticky ATC Bar -->
  <div class="dk-mobile-sticky" aria-label="Add to cart" id="dk-mobile-sticky">
    <div class="dk-mobile-sticky__info">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 60 }}" alt="{{ product.title | escape }}" width="60" height="60" loading="lazy">
      {%- endif -%}
      <div>
        <p class="dk-mobile-sticky__title">{{ product.title | truncate: 40 }}</p>
        <p class="dk-mobile-sticky__price">{{ current_variant.price | money }}</p>
      </div>
    </div>
    {%- if product.available -%}
      <button class="dk-btn dk-btn--dark dk-mobile-sticky__btn" id="dk-mobile-atc">Add To Cart</button>
    {%- else -%}
      <button class="dk-btn dk-btn--disabled" disabled>Sold Out</button>
    {%- endif -%}
  </div>

</div><!-- /.dk-product-page -->
