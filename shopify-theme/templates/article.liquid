<!-- ================================================ -->
<!-- ARTICLE (BLOG POST) TEMPLATE                   -->
<!-- ================================================ -->
<article class="dk-article dk-container" aria-labelledby="dk-article-title">

  <!-- Back link -->
  <a href="{{ blog.url }}" class="dk-article__back">
    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Back to Blog
  </a>

  <!-- Header -->
  <header class="dk-article__header">

    <!-- Tags -->
    {%- if article.tags.size > 0 -%}
      <div class="dk-article__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="dk-article__tag">
            {{ tag | capitalize }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <h1 class="dk-article__title" id="dk-article-title">{{ article.title }}</h1>

    <div class="dk-article__meta">
      <span class="dk-author-avatar" aria-hidden="true">{{ article.author | slice: 0, 1 | upcase }}</span>
      <span>{{ article.author }}</span>
      <span class="dk-article__meta-sep" aria-hidden="true">·</span>
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
      <span class="dk-article__meta-sep" aria-hidden="true">·</span>
      <span>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
    </div>

  </header>

  <!-- Featured Image -->
  {%- if article.image -%}
    <div class="dk-article__cover">
      <img
        src="{{ article.image | image_url: width: 1200 }}"
        alt="{{ article.image.alt | default: article.title | escape }}"
        class="dk-article__cover-img"
        width="1200"
        height="630"
        loading="eager"
      >
    </div>
  {%- endif -%}

  <!-- Article Content -->
  <div class="dk-article__content dk-rte">
    {{ article.content }}
  </div>

  <!-- Tags Footer -->
  {%- if article.tags.size > 0 -%}
    <div class="dk-article__tags-footer">
      <strong>Topics:</strong>
      {%- for tag in article.tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="dk-article__tag">{{ tag | capitalize }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <!-- Share -->
  <div class="dk-article__share">
    <strong>Share this article:</strong>
    <div class="dk-article__share-btns">
      <a href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ canonical_url | url_encode }}" target="_blank" rel="noopener" class="dk-share-btn dk-share-btn--twitter" aria-label="Share on X">
        <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
      </a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener" class="dk-share-btn dk-share-btn--facebook" aria-label="Share on Facebook">
        <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
      </a>
      <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ canonical_url | url_encode }}" target="_blank" rel="noopener" class="dk-share-btn dk-share-btn--whatsapp" aria-label="Share on WhatsApp">
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <!-- Comments (Shopify native) -->
  {%- if blog.comments_enabled? -%}
    <section class="dk-article__comments" aria-labelledby="dk-comments-heading">
      <h2 id="dk-comments-heading">Comments ({{ article.comments_count }})</h2>
      {%- for comment in article.comments -%}
        <div class="dk-comment" id="comment-{{ comment.id }}">
          <div class="dk-comment__avatar" aria-hidden="true">{{ comment.author | slice: 0, 1 | upcase }}</div>
          <div class="dk-comment__body">
            <div class="dk-comment__meta">
              <strong>{{ comment.author }}</strong>
              <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: '%d %b %Y' }}</time>
            </div>
            <p>{{ comment.content }}</p>
          </div>
        </div>
      {%- endfor -%}
      {%- form 'new_comment', article, id: 'dk-comment-form', class: 'dk-comment-form' -%}
        <h3>Leave a comment</h3>
        <div class="dk-float-field"><input type="text" name="comment[author]" id="comment-author" placeholder=" " required><label for="comment-author">Name *</label></div>
        <div class="dk-float-field"><input type="email" name="comment[email]" id="comment-email" placeholder=" " required><label for="comment-email">Email *</label></div>
        <div class="dk-float-field dk-float-field--full"><textarea name="comment[body]" id="comment-body" rows="5" placeholder=" " required></textarea><label for="comment-body">Comment *</label></div>
        <button type="submit" class="dk-btn dk-btn--dark">Post Comment</button>
        {%- if form.errors -%}<div class="dk-contact-form__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        {%- if form.posted_successfully? -%}<p class="dk-comment-success">✓ Your comment has been posted!</p>{%- endif -%}
      {%- endform -%}
    </section>
  {%- endif -%}

  <!-- Related Posts -->
  {%- if blog.articles.size > 1 -%}
    <section class="dk-article__related" aria-labelledby="dk-related-articles-heading">
      <h2 id="dk-related-articles-heading">You Might Also Like</h2>
      <div class="dk-blog-grid-mini">
        {%- for a in blog.articles limit: 3 -%}
          {%- unless a.id == article.id -%}
            <a href="{{ a.url }}" class="dk-blog-mini-card">
              {%- if a.image -%}
                <img src="{{ a.image | image_url: width: 400 }}" alt="{{ a.image.alt | default: a.title | escape }}" loading="lazy" width="200" height="130">
              {%- endif -%}
              <h4>{{ a.title }}</h4>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

</article>

<style>
.dk-article { max-width: 820px; margin: 0 auto; padding: 32px 0 80px; }
.dk-article__back { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #737373; margin-bottom: 24px; transition: color .2s; }
.dk-article__back:hover { color: var(--dk-red); }
.dk-article__header { margin-bottom: 28px; }
.dk-article__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
.dk-article__tag { display: inline-flex; padding: 4px 12px; border-radius: 999px; background: #fef7ee; color: #b45309; font-size: 11.5px; font-weight: 700; border: 1px solid rgba(245,158,11,.3); transition: background .2s; }
.dk-article__tag:hover { background: #fde68a; }
.dk-article__title { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; line-height: 1.2; color: var(--dk-ink); margin-bottom: 16px; }
.dk-article__meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 13px; color: #737373; }
.dk-article__meta .dk-author-avatar { width: 34px; height: 34px; font-size: 14px; }
.dk-article__meta-sep { color: #d4d4d4; }
.dk-article__cover { border-radius: 20px; overflow: hidden; margin-bottom: 40px; background: #f5f5f4; border: 1px solid var(--dk-border); }
.dk-article__cover-img { width: 100%; height: auto; max-height: 500px; object-fit: cover; }
.dk-article__content { font-size: 16px; line-height: 1.9; color: #404040; margin-bottom: 40px; }
.dk-article__content h2 { font-size: 1.5rem; margin: 32px 0 14px; color: var(--dk-ink); }
.dk-article__content h3 { font-size: 1.2rem; margin: 24px 0 12px; color: var(--dk-ink); }
.dk-article__tags-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 28px; font-size: 13px; }
.dk-article__share { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding: 20px 0; border-top: 1px solid var(--dk-border); border-bottom: 1px solid var(--dk-border); margin-bottom: 48px; font-size: 14px; font-weight: 700; color: var(--dk-ink); }
.dk-article__share-btns { display: flex; gap: 10px; }
.dk-share-btn { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-size: 16px; color: #fff; transition: transform .25s var(--dk-ease); }
.dk-share-btn:hover { transform: translateY(-4px) rotate(10deg); }
.dk-share-btn--twitter { background: #000; }
.dk-share-btn--facebook { background: #1877f2; }
.dk-share-btn--whatsapp { background: #25d366; }
.dk-article__comments { margin-bottom: 48px; }
.dk-article__comments h2 { font-size: 1.4rem; margin-bottom: 24px; }
.dk-comment { display: flex; gap: 14px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--dk-border); }
.dk-comment__avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--dk-amber), var(--dk-red)); color: #fff; display: grid; place-items: center; font-weight: 800; flex-shrink: 0; }
.dk-comment__meta { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; font-size: 13px; }
.dk-comment__meta strong { font-weight: 700; }
.dk-comment__meta time { color: #a3a3a3; }
.dk-comment-form h3 { font-size: 1.2rem; margin: 32px 0 16px; }
.dk-comment-form .dk-float-field { margin-bottom: 14px; }
.dk-comment-success { margin-top: 14px; color: #15803d; font-weight: 700; }
.dk-article__related { margin-top: 24px; }
.dk-article__related h2 { font-size: 1.3rem; margin-bottom: 20px; }
.dk-blog-grid-mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.dk-blog-mini-card { border: 1px solid var(--dk-border); border-radius: 14px; overflow: hidden; background: #fff; transition: transform .3s var(--dk-ease), border-color .2s; display: block; }
.dk-blog-mini-card:hover { transform: translateY(-4px); border-color: var(--dk-amber); }
.dk-blog-mini-card img { width: 100%; height: 120px; object-fit: cover; }
.dk-blog-mini-card h4 { padding: 10px 12px; font-size: 12.5px; font-weight: 700; line-height: 1.4; color: var(--dk-ink); }
</style>
