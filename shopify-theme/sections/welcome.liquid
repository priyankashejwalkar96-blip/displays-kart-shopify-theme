<!-- ================================================ -->
<!-- WHY ACRYLIC / WELCOME SECTION                  -->
<!-- ================================================ -->
<section class="dk-welcome" aria-labelledby="dk-welcome-heading">
  <div class="dk-welcome__bg-tints" aria-hidden="true"></div>
  <div class="dk-welcome__accent-line" aria-hidden="true"></div>

  <div class="dk-container">
    <div class="dk-welcome__content">

      <!-- Label -->
      <p class="dk-welcome__label">
        <span class="dk-welcome__label-line" aria-hidden="true"></span>
        India's Acrylic Destination
        <span class="dk-welcome__label-line" aria-hidden="true"></span>
      </p>

      <!-- Heading -->
      <h2 class="dk-welcome__heading" id="dk-welcome-heading">
        Welcome to DisplaysKart &mdash;
        <span class="dk-welcome__heading-gradient">India's Trusted Acrylic Display Store</span>
      </h2>

      <!-- Divider -->
      <div class="dk-welcome__divider" aria-hidden="true">
        <div class="dk-welcome__divider-line"></div>
        <div class="dk-welcome__divider-dot"></div>
        <div class="dk-welcome__divider-line dk-welcome__divider-line--right"></div>
      </div>

      <!-- Description -->
      <p class="dk-welcome__desc">
        DisplaysKart is your one-stop manufacturer &amp; supplier for premium
        <strong>sign holders</strong>, acrylic photo frames,
        <strong>lockable donation boxes</strong>, brochure organizers, and riser stands engineered for
        <strong>retail stores</strong>, hotels, corporate offices, and exhibitions.
      </p>

      <!-- Why Choose Card -->
      <div class="dk-acrylic-card">
        <div class="dk-acrylic-card__glow" aria-hidden="true"></div>
        <div class="dk-acrylic-card__icon" aria-hidden="true">&#128161;</div>
        <h3 class="dk-acrylic-card__title">Why Choose Acrylic Display Stands?</h3>
        <p class="dk-acrylic-card__text">
          Crafted from virgin cast acrylic sheets, our display stands are
          <strong>lightweight</strong>, highly <strong>durable</strong>,
          <strong>shatter-resistant</strong>, and provide
          <strong class="dk-text-amber">crystal clear 94%+ optical light transmission</strong>
          surpassing glass.
        </p>
        <div class="dk-acrylic-card__pills">
          <span class="dk-pill">&#9733; 4.9 Quality Rating</span>
          <span class="dk-pill">&#128666; Pan-India Delivery</span>
          <span class="dk-pill">&#127981; Direct Manufacturer</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Welcome / Why Acrylic",
  "tag": "section",
  "class": "dk-welcome-section",
  "presets": [
    { "name": "Welcome Section" }
  ]
}
{% endschema %}
