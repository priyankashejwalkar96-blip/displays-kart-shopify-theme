<!-- ================================================ -->
<!-- USP STRIP SECTION                              -->
<!-- ================================================ -->
<section class="dk-usp-strip" aria-label="Why shop with us">
  <div class="dk-container">
    <div class="dk-usp-strip__grid">

      <div class="dk-usp-card">
        <div class="dk-usp-card__icon">
          <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
        </div>
        <div>
          <h4 class="dk-usp-card__title">Free shipping above &#8377;1000</h4>
          <p class="dk-usp-card__sub">Safely boxed pan-India dispatch</p>
        </div>
      </div>

      <div class="dk-usp-card">
        <div class="dk-usp-card__icon">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        </div>
        <div>
          <h4 class="dk-usp-card__title">Secure payment</h4>
          <p class="dk-usp-card__sub">100% Protected Razorpay checkout</p>
        </div>
      </div>

      <div class="dk-usp-card">
        <div class="dk-usp-card__icon">
          <i class="fa-solid fa-headset" aria-hidden="true"></i>
        </div>
        <div>
          <h4 class="dk-usp-card__title">Help center</h4>
          <p class="dk-usp-card__sub">Call/WhatsApp: +91 79000 54449</p>
        </div>
      </div>

      <div class="dk-usp-card">
        <div class="dk-usp-card__icon">
          <i class="fa-solid fa-percent" aria-hidden="true"></i>
        </div>
        <div>
          <h4 class="dk-usp-card__title">5% discount on bulk</h4>
          <p class="dk-usp-card__sub">Automatic cart tier discounts</p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "USP Strip",
  "tag": "section",
  "class": "dk-usp-section",
  "presets": [
    { "name": "USP Strip" }
  ]
}
{% endschema %}
