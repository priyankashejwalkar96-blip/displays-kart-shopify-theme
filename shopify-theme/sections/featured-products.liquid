<!-- ================================================ -->
<!-- FEATURED PRODUCTS SECTION                      -->
<!-- ================================================ -->
<section class="dk-featured-products" aria-labelledby="dk-featured-heading-{{ section.id }}">
  <div class="dk-container">

    <!-- Section Header -->
    <div class="dk-section-header dk-section-header--center">
      {%- if section.settings.subheading != blank -%}
        <p class="dk-section-header__label">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <h2 class="dk-section-header__title font-heading" id="dk-featured-heading-{{ section.id }}">
        {{ section.settings.heading | split: '|' | first }}
        {%- assign highlight = section.settings.heading | split: '|' | last -%}
        {%- if section.settings.heading contains '|' -%}
          <span class="dk-text-highlight">{{ highlight }}</span>
        {%- endif -%}
      </h2>
      <div class="dk-section-header__divider" aria-hidden="true"></div>
    </div>

    <!-- Products Grid -->
    <div class="dk-product-grid dk-product-grid--4col" id="dk-featured-grid-{{ section.id }}">
      {%- if section.settings.collection != blank -%}
        {%- assign featured_collection = collections[section.settings.collection] -%}
        {%- assign products_to_show = section.settings.products_count | default: 4 -%}
        {%- if featured_collection.products.size > 0 -%}
          {%- for product in featured_collection.products limit: products_to_show -%}
            {% render 'product-card', product: product, section_id: section.id %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..products_to_show) -%}
            <article class="dk-product-card dk-product-card--placeholder">
              {{ 'product-' | append: i | placeholder_svg_tag: 'dk-product-card__img' }}
              <div class="dk-product-card__body">
                <h3 class="dk-product-card__title">Sample Product {{ i }}</h3>
                <div class="dk-product-card__price-wrap"><span class="dk-product-card__price">&#8377;999</span></div>
                <button class="dk-btn dk-btn--dark dk-product-card__atc">Add To Cart</button>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="dk-product-card dk-product-card--placeholder">
            {{ 'product-' | append: i | placeholder_svg_tag: 'dk-product-card__img' }}
            <div class="dk-product-card__body">
              <h3 class="dk-product-card__title">Sample Product {{ i }}</h3>
              <div class="dk-product-card__price-wrap"><span class="dk-product-card__price">&#8377;999</span></div>
              <button class="dk-btn dk-btn--dark dk-product-card__atc">Add To Cart</button>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="dk-section-footer">
        <a href="{{ section.settings.view_all_link | default: routes.collections_url }}" class="dk-btn dk-btn--outline">
          View All Products <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "dk-featured-products-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Label above heading", "default": "FEATURED PRODUCTS" },
    { "type": "text", "id": "heading", "label": "Heading (use | to highlight)", "default": "SHOP OUR|COLLECTIONS" },
    { "type": "collection", "id": "collection", "label": "Collection to display" },
    { "type": "range", "id": "products_count", "label": "Number of products", "min": 2, "max": 12, "step": 2, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View All' button", "default": true },
    { "type": "url", "id": "view_all_link", "label": "View All link" }
  ],
  "presets": [
    { "name": "Featured Products", "settings": { "heading": "SHOP OUR|COLLECTIONS", "products_count": 4 } }
  ]
}
{% endschema %}
