<!-- ================================================ -->
<!-- TESTIMONIALS SECTION                           -->
<!-- ================================================ -->
<section class="dk-testimonials" aria-labelledby="dk-testimonials-heading">
  <div class="dk-container">
    <div class="dk-section-header dk-section-header--center">
      <p class="dk-section-header__label">{{ section.settings.label }}</p>
      <h2 class="dk-section-header__title font-heading" id="dk-testimonials-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="dk-testimonials__grid">
      {%- for block in section.blocks -%}
        <article class="dk-review-card" {{ block.shopify_attributes }}>
          <div class="dk-review-card__top">
            <div class="dk-review-card__avatar" aria-hidden="true">{{ block.settings.name | slice: 0, 1 | upcase }}</div>
            <div class="dk-review-card__author">
              <strong>{{ block.settings.name }}</strong>
              <span class="dk-review-card__location">{{ block.settings.location }}</span>
            </div>
            <div class="dk-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <i class="fa-solid fa-star{% unless i <= block.settings.rating %} dk-star--empty{% endunless %}" aria-hidden="true"></i>
              {%- endfor -%}
            </div>
          </div>
          <blockquote class="dk-review-card__quote">{{ block.settings.review }}</blockquote>
          {%- if block.settings.product_purchased != blank -%}
            <p class="dk-review-card__product">
              <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
              Verified purchase: {{ block.settings.product_purchased }}
            </p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    <!-- Rating Summary -->
    <div class="dk-testimonials__summary">
      <div class="dk-rating-summary">
        <div class="dk-rating-summary__score">4.9</div>
        <div>
          <div class="dk-rating-summary__stars" aria-label="4.9 out of 5 stars">
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
          </div>
          <p class="dk-rating-summary__count">Based on 2,500+ verified reviews</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "dk-testimonials-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "CUSTOMER LOVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "Priya S." },
        { "type": "text", "id": "location", "label": "Location", "default": "Mumbai" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "review", "label": "Review text", "default": "Excellent quality acrylic frames! Exactly what I needed for my hotel lobby. Fast delivery and great packaging." },
        { "type": "text", "id": "product_purchased", "label": "Product purchased", "default": "Magnetic T-Style Sign Holder" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "name": "Priya S.", "location": "Mumbai", "rating": 5, "review": "Excellent quality acrylic frames! Exactly what I needed for my hotel lobby. Fast delivery and great packaging.", "product_purchased": "Magnetic T-Style Sign Holder" } },
        { "type": "review", "settings": { "name": "Rahul M.", "location": "Delhi", "rating": 5, "review": "Best acrylic displays in India! Ordered 50 units for our retail chain. Superb quality and bulk discount was a great deal.", "product_purchased": "Clear Acrylic Sign Holder A4" } },
        { "type": "review", "settings": { "name": "Anita K.", "location": "Bengaluru", "rating": 5, "review": "The donation boxes are solid and beautifully clear. Our temple visitors love them. Will order again!", "product_purchased": "Acrylic Donation Box with Lock" } }
      ]
    }
  ]
}
{% endschema %}
