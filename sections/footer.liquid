<footer id="site-footer">
  <div class="ft-wrap">
    {%- if section.settings.cta_heading != blank -%}
    <div class="ft-cta">
      <div>
        <h3>{{ section.settings.cta_heading }}</h3>
        <p>{{ section.settings.cta_text }}</p>
      </div>
      {%- if section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="ft-cta-btn">{{ section.settings.cta_label }} <i class="fa-solid fa-arrow-right"></i></a>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="ft-grid">
      <div class="ft-brand">
        <div class="ft-logo">{{ section.settings.logo_text_1 }} <span>{{ section.settings.logo_text_2 }}</span></div>
        <p>{{ section.settings.about }}</p>
        <div class="ft-soc">
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" title="Facebook" rel="noopener" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>{%- endif -%}
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" title="Instagram" rel="noopener" target="_blank"><i class="fa-brands fa-instagram"></i></a>{%- endif -%}
          {%- if settings.social_twitter != blank -%}<a href="{{ settings.social_twitter }}" title="X" rel="noopener" target="_blank"><i class="fa-brands fa-x-twitter"></i></a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" title="YouTube" rel="noopener" target="_blank"><i class="fa-brands fa-youtube"></i></a>{%- endif -%}
          {%- if settings.social_linkedin != blank -%}<a href="{{ settings.social_linkedin }}" title="LinkedIn" rel="noopener" target="_blank"><i class="fa-brands fa-linkedin-in"></i></a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'links' -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.title }}</h4>
              <ul>
                {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                  {%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
                {%- else -%}
                  {%- assign lines = block.settings.links | newline_to_br | strip_newlines | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign parts = line | split: '|' -%}
                    {%- if parts.size > 1 -%}<li><a href="{{ parts.last | strip }}">{{ parts.first | strip }}</a></li>{%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- when 'contact' -%}
            <div class="ft-contact" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.title }}</h4>
              <ul>
                {%- if block.settings.address != blank -%}<li><i class="fa-solid fa-location-dot"></i><span>{{ block.settings.address }}</span></li>{%- endif -%}
                {%- if block.settings.phone != blank -%}<li><i class="fa-solid fa-phone"></i><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a></li>{%- endif -%}
                {%- if block.settings.email_1 != blank -%}<li><i class="fa-regular fa-envelope"></i><a href="mailto:{{ block.settings.email_1 }}">{{ block.settings.email_1 }}</a></li>{%- endif -%}
                {%- if block.settings.email_2 != blank -%}<li><i class="fa-regular fa-envelope"></i><a href="mailto:{{ block.settings.email_2 }}">{{ block.settings.email_2 }}</a></li>{%- endif -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="ft-bar">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.rights' | t }}</span>
      {%- if section.settings.show_payment_icons -%}
        <span class="ft-pay"><i class="fa-brands fa-cc-visa"></i><i class="fa-brands fa-cc-mastercard"></i><i class="fa-solid fa-building-columns"></i><b>UPI</b></span>
      {%- endif -%}
      {%- if section.settings.credit != blank -%}<span>{{ section.settings.credit }}</span>{%- endif -%}
    </div>
  </div>
  <button type="button" class="ft-top" aria-label="{{ 'general.back_to_top' | t }}" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i class="fa-solid fa-chevron-up"></i></button>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Need a custom acrylic display?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text",
      "default": "Tell us your size and quantity. We reply within 24 hours."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Get a free quote"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "logo_text_1",
      "label": "Logo – first word",
      "default": "Displays"
    },
    {
      "type": "text",
      "id": "logo_text_2",
      "label": "Logo – highlighted word",
      "default": "Kart"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "We make quality, stylish acrylic displays for shops, hotels, offices and homes. Direct manufacturer and importer, delivering across India."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Credit line",
      "default": "Designed and developed by Webiz Square Software Solutions"
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links (one per line: Label | /url)",
          "default": "All products | /collections/all"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Or use a menu (overrides the lines above)"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact details",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Behind Bajaj Show Room, 6th Main Road, HVR Layout, Kamakshi Palya, Bengaluru – 560079"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+91 79000 54449"
        },
        {
          "type": "text",
          "id": "email_1",
          "label": "Email 1",
          "default": "sales@displayskart.com"
        },
        {
          "type": "text",
          "id": "email_2",
          "label": "Email 2",
          "default": "support@displayskart.com"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "links",
        "settings": {
          "title": "Shop"
        }
      },
      {
        "type": "links",
        "settings": {
          "title": "Company"
        }
      },
      {
        "type": "links",
        "settings": {
          "title": "Policies"
        }
      },
      {
        "type": "contact"
      }
    ]
  }
}
{% endschema %}
