{%- comment -%} Three mini columns: Top Rated / Best Seller / On Sale {%- endcomment -%}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-gray-200">
  <div class="grid md:grid-cols-3 gap-10">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <div {{ block.shopify_attributes }}>
        <h3 class="font-heading font-black text-sm text-red-600 uppercase tracking-wider mb-4 pb-2 border-b border-gray-200">{{ block.settings.title }}</h3>
        <ul class="space-y-4">
          {%- if col != blank -%}
            {%- for product in col.products limit: block.settings.limit -%}
              <li>
                <a href="{{ product.url }}" class="flex items-center gap-3 group">
                  <div class="w-16 h-16 rounded-lg bg-gray-50 border border-gray-200 overflow-hidden shrink-0">
                    {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover" loading="lazy" width="64" height="64">{%- endif -%}
                  </div>
                  <div>
                    <div class="text-xs font-bold text-neutral-900 group-hover:text-red-600 transition leading-snug">{{ product.title | truncate: 60 }}</div>
                    <div class="text-xs font-black text-red-600 mt-1">{{ product.price | money }}</div>
                  </div>
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Mini product lists",
  "tag": "div",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "list", "name": "Product list",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Top Rated" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 6, "step": 1, "default": 3 }
      ]
    }
  ],
  "presets": [
    { "name": "Mini product lists", "blocks": [
      { "type": "list", "settings": { "title": "Top Rated" } },
      { "type": "list", "settings": { "title": "Best Seller" } },
      { "type": "list", "settings": { "title": "On Sale" } }
    ] }
  ]
}
{% endschema %}
