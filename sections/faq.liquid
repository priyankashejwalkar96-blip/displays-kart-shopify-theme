<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-gray-200">
  <h2 class="text-center text-2xl sm:text-3xl font-black font-heading text-neutral-900 uppercase tracking-tight">{{ section.settings.heading }}</h2>
  {%- if section.settings.text != blank -%}<div class="text-center text-sm text-gray-500 mt-3 mb-8 max-w-2xl mx-auto">{{ section.settings.text }}</div>{%- endif -%}
  <div class="space-y-3 mt-8">
    {%- for block in section.blocks -%}
      <details class="bg-white border border-gray-200 rounded-xl p-5 group" {{ block.shopify_attributes }}>
        <summary class="flex justify-between items-center cursor-pointer font-bold text-sm text-neutral-900">
          {{ block.settings.question }}
          <i class="fa-solid fa-plus text-amber-500 text-xs group-open:rotate-45 transition"></i>
        </summary>
        <div class="text-xs text-gray-600 mt-3 leading-relaxed">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy Acrylic Display Stands Wholesale in India" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>We offer 5% discount on bulk orders and cater to wholesale buyers, event managers, corporate offices and institutional buyers across India.</p>" }
  ],
  "blocks": [
    {
      "type": "item", "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is the best acrylic display stand for retail?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Contact our team for the right option for your space, size and quantity.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [
      { "type": "item", "settings": { "question": "What is the best acrylic display stand for retail?" } },
      { "type": "item", "settings": { "question": "Where can I buy acrylic display stands wholesale in India?" } },
      { "type": "item", "settings": { "question": "Are acrylic sign holders good for restaurants and hotels?" } },
      { "type": "item", "settings": { "question": "Is a transparent acrylic donation box with a lock available?" } }
    ] }
  ]
}
{% endschema %}
