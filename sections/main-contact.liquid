<section class="ct-hero cx-hero text-white">
  <div class="cx-grid-bg"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-28 lg:pt-14 lg:pb-36 relative">
    <nav class="flex items-center gap-2 text-xs text-neutral-400 mb-6" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="hover:text-amber-400">{{ 'general.home' | t }}</a><span>/</span><span class="text-white font-semibold">{{ page.title }}</span>
    </nav>
    {%- if section.settings.pill != blank -%}<span class="cx-pill"><span class="cx-dot"></span> {{ section.settings.pill }}</span>{%- endif -%}
    <h1 class="font-heading font-black text-4xl sm:text-5xl lg:text-6xl leading-[1.08] max-w-3xl mt-5">{{ section.settings.heading }} <span class="cx-grad">{{ section.settings.heading_highlight }}</span></h1>
    <p class="mt-5 text-neutral-300 text-sm sm:text-base max-w-xl leading-relaxed">{{ section.settings.text }}</p>
    <div class="flex flex-wrap gap-x-8 gap-y-3 mt-8 text-sm text-neutral-300">
      {%- for block in section.blocks -%}{%- if block.type == 'perk' -%}<span {{ block.shopify_attributes }}><i class="fa-solid fa-circle-check text-amber-400 mr-2"></i>{{ block.settings.text }}</span>{%- endif -%}{%- endfor -%}
    </div>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-20 lg:-mt-24 pb-16 lg:pb-24 relative z-10">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    {%- if section.settings.phone != blank -%}
      <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="cx-quick"><span class="cx-qico"><i class="fa-solid fa-phone"></i></span><b>{{ 'contact.call_us' | t }}</b><small>{{ section.settings.phone }}</small></a>
    {%- endif -%}
    {%- if section.settings.whatsapp != blank -%}
      <a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" class="cx-quick"><span class="cx-qico"><i class="fa-brands fa-whatsapp"></i></span><b>WhatsApp</b><small>{{ 'contact.whatsapp_sub' | t }}</small></a>
    {%- endif -%}
    {%- if section.settings.email != blank -%}
      <a href="mailto:{{ section.settings.email }}" class="cx-quick"><span class="cx-qico"><i class="fa-regular fa-envelope"></i></span><b>{{ 'contact.email' | t }}</b><small>{{ section.settings.email }}</small></a>
    {%- endif -%}
    {%- if section.settings.address != blank -%}
      <a href="#cx-map" class="cx-quick"><span class="cx-qico"><i class="fa-solid fa-location-dot"></i></span><b>{{ 'contact.visit_us' | t }}</b><small>{{ section.settings.address_short }}</small></a>
    {%- endif -%}
  </div>

  <div class="grid lg:grid-cols-12 gap-6 mt-6">
    <div class="lg:col-span-7 cx-card p-6 sm:p-8 lg:p-10">
      <h2 class="font-heading font-black text-3xl text-neutral-900 tracking-tight">{{ 'contact.form_title' | t }}</h2>
      <p class="text-sm text-neutral-500 mt-1 mb-7">{{ 'contact.required_note' | t }}</p>

      {%- form 'contact', id: 'ContactForm', class: 'space-y-5' -%}
        {%- if form.posted_successfully? -%}
          <div class="text-center py-10">
            <div class="tick" style="width:72px;height:72px;margin:0 auto 18px;border-radius:50%;display:grid;place-items:center;background:#ecfdf5;color:#059669;font-size:30px"><i class="fa-solid fa-check"></i></div>
            <h3 class="font-heading font-extrabold text-2xl mb-2">{{ 'contact.sent_title' | t }}</h3>
            <p class="text-sm text-neutral-500 mb-6 max-w-sm mx-auto">{{ 'contact.sent_text' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="px-6 py-2.5 rounded-xl text-sm font-bold border border-neutral-300 hover:border-amber-500 transition">{{ 'contact.browse' | t }}</a>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm p-4" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <fieldset>
            <legend class="text-xs font-bold text-neutral-800 uppercase tracking-wider mb-2.5">{{ 'contact.topic' | t }}</legend>
            <div class="flex flex-wrap gap-2" role="radiogroup">
              {%- assign topics = section.settings.topics | split: ',' -%}
              {%- for topic in topics -%}
                {%- assign t = topic | strip -%}
                <label class="ct-chip"><input type="radio" name="contact[Topic]" value="{{ t | escape }}" {% if forloop.first %}checked{% endif %}><span>{{ t }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="cx-field"><input id="ct-n" name="contact[name]" type="text" placeholder=" " autocomplete="name" value="{{ form.name }}" required><label for="ct-n">{{ 'forms.name' | t }} *</label></div>
            <div class="cx-field"><input id="ct-e" name="contact[email]" type="email" placeholder=" " autocomplete="email" value="{{ form.email }}" required><label for="ct-e">{{ 'forms.email' | t }} *</label></div>
            <div class="cx-field"><input id="ct-p" name="contact[phone]" type="tel" placeholder=" " autocomplete="tel" value="{{ form.phone }}"><label for="ct-p">{{ 'forms.phone' | t }}</label></div>
            <div class="cx-field"><input id="ct-c" name="contact[Company]" type="text" placeholder=" " autocomplete="organization"><label for="ct-c">{{ 'forms.company' | t }}</label></div>
          </div>
          <div class="cx-field">
            <textarea id="ct-m" name="contact[body]" rows="6" maxlength="800" placeholder=" " required>{{ form.body }}</textarea>
            <label for="ct-m">{{ 'forms.message' | t }} *</label>
            <span class="cx-count" data-count-for="ct-m">0 / 800</span>
          </div>
          <div class="flex flex-wrap items-center gap-4 pt-1">
            <button type="submit" class="ct-send cx-btn"><span class="cx-btn-label">{{ 'contact.send' | t }} <i class="fa-solid fa-paper-plane"></i></span></button>
            <span class="text-xs text-neutral-500"><i class="fa-solid fa-lock text-amber-500 mr-1"></i>{{ 'contact.private' | t }}</span>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="lg:col-span-5 space-y-6">
      {%- if section.settings.hours_title != blank -%}
      <div class="cx-card cx-dark p-6 sm:p-7">
        <h3 class="font-heading font-extrabold text-lg mb-4">{{ section.settings.hours_title }}</h3>
        <ul class="text-sm space-y-2.5">
          {%- for block in section.blocks -%}{%- if block.type == 'hours' -%}<li {{ block.shopify_attributes }}><span>{{ block.settings.days }}</span><b>{{ block.settings.hours }}</b></li>{%- endif -%}{%- endfor -%}
        </ul>
        <p class="text-[11px] text-neutral-400 mt-4">{{ section.settings.hours_note }}</p>
      </div>
      {%- endif -%}
      {%- if section.settings.address != blank -%}
      <div class="cx-card p-6 sm:p-7">
        <div class="flex gap-4">
          <span class="cx-qico shrink-0"><i class="fa-solid fa-location-dot"></i></span>
          <div>
            <h3 class="font-heading font-extrabold text-lg text-neutral-900">{{ 'contact.workshop' | t }}</h3>
            <p class="text-sm text-neutral-600 leading-relaxed mt-1">{{ section.settings.address }}</p>
            <a target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query={{ section.settings.address | url_encode }}" class="inline-flex items-center gap-1.5 mt-3 text-sm font-bold text-red-600 hover:underline">{{ 'contact.directions' | t }} <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i></a>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.address != blank -%}
    <div id="cx-map" class="mt-14 cx-card overflow-hidden relative" style="height:340px;padding:0">
      <iframe title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0;width:100%;height:100%" src="https://www.google.com/maps?q={{ section.settings.address | url_encode }}&output=embed"></iframe>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "pill", "label": "Hero pill", "default": "Support team online · replies within 24 hours" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let’s build your" },
    { "type": "text", "id": "heading_highlight", "label": "Highlighted heading", "default": "perfect display." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about acrylic displays, bulk pricing or custom sizes? Tell us what you need and our team will get back to you." },
    { "type": "header", "content": "Quick contact cards" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 79000 54449" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (with country code)", "default": "917900054449" },
    { "type": "text", "id": "email", "label": "Email", "default": "support@displayskart.com" },
    { "type": "textarea", "id": "address", "label": "Full address", "default": "Behind Bajaj Show Room, 6th Main Road, HVR Layout, Kamakshi Palya, Bengaluru – 560079" },
    { "type": "text", "id": "address_short", "label": "Short address", "default": "Kamakshi Palya, Bengaluru" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "topics", "label": "Topic chips (comma separated)", "default": "Product enquiry, Bulk order, Custom size, Order support" },
    { "type": "header", "content": "Opening hours" },
    { "type": "text", "id": "hours_title", "label": "Heading", "default": "Opening hours" },
    { "type": "text", "id": "hours_note", "label": "Note", "default": "Online orders and email enquiries are answered 7 days a week." }
  ],
  "blocks": [
    { "type": "perk", "name": "Hero perk", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free quotes" } ] },
    { "type": "hours", "name": "Opening hours row", "settings": [ { "type": "text", "id": "days", "label": "Days", "default": "Monday – Saturday" }, { "type": "text", "id": "hours", "label": "Hours", "default": "10:00 AM – 7:00 PM" } ] }
  ]
}
{% endschema %}
