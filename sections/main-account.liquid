<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="font-heading font-black text-3xl text-neutral-900 uppercase tracking-tight">{{ 'customer.account' | t }}</h1>
      <p class="text-sm text-neutral-500 mt-1">{%- assign display_name = customer.first_name | default: customer.email -%}{{ 'customer.welcome' | t: name: display_name }}</p>
    </div>
    <a href="{{ routes.account_logout_url }}" class="text-xs font-bold text-red-600 hover:underline"><i class="fa-solid fa-right-from-bracket mr-1"></i>{{ 'customer.logout' | t }}</a>
  </div>

  <div class="grid lg:grid-cols-12 gap-6">
    <div class="lg:col-span-8">
      <div class="in-card">
        <h2 class="font-heading font-extrabold text-xl mb-4">{{ 'customer.orders' | t }}</h2>
        {%- paginate customer.orders by 10 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="overflow-x-auto">
              <table class="pd-spec w-full text-left">
                <thead><tr class="text-xs uppercase text-neutral-500"><th class="!w-auto">{{ 'customer.order' | t }}</th><th class="!w-auto">{{ 'customer.date' | t }}</th><th class="!w-auto">{{ 'customer.payment' | t }}</th><th class="!w-auto">{{ 'customer.fulfillment' | t }}</th><th class="!w-auto">{{ 'cart.total' | t }}</th></tr></thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td><a href="{{ order.customer_url }}" class="text-red-600 font-bold">{{ order.name }}</a></td>
                      <td>{{ order.created_at | date: '%d %b %Y' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p class="text-sm text-neutral-500">{{ 'customer.no_orders' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="inline-block mt-4 bg-neutral-900 hover:bg-red-600 text-white font-bold text-xs px-6 py-2.5 rounded-lg transition uppercase tracking-wider">{{ 'cart.continue' | t }}</a>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
    <aside class="lg:col-span-4">
      <div class="in-card">
        <h2 class="font-heading font-extrabold text-lg mb-3">{{ 'customer.details' | t }}</h2>
        <p class="text-sm font-bold">{{ customer.name }}</p>
        <p class="text-xs text-neutral-500">{{ customer.email }}</p>
        {%- if customer.default_address -%}<div class="text-sm text-neutral-600 mt-3">{{ customer.default_address | format_address }}</div>{%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="inline-block mt-4 text-xs font-bold text-red-600 hover:underline">{{ 'customer.view_addresses' | t }} ({{ customer.addresses_count }})</a>
      </div>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
