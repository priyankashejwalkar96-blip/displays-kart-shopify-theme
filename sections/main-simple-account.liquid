<div class="max-w-md mx-auto px-4 py-12">
  <div class="pd-card p-6 sm:p-8">
    {%- if template.name == 'customers/reset_password' -%}
      <h1 class="font-heading font-black text-2xl">{{ 'customer.reset.title' | t }}</h1>
      {%- form 'reset_customer_password', class: 'space-y-4 mt-6' -%}
        {%- if form.errors -%}<div class="rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm p-4">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="cx-field"><input type="password" name="customer[password]" id="ResetPassword" placeholder=" " required><label for="ResetPassword">{{ 'forms.password' | t }}</label></div>
        <div class="cx-field"><input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" placeholder=" " required><label for="ResetPasswordConfirm">{{ 'forms.password_confirm' | t }}</label></div>
        <button type="submit" class="cx-btn w-full" style="width:100%"><span class="cx-btn-label">{{ 'customer.reset.submit' | t }}</span></button>
      {%- endform -%}
    {%- else -%}
      <h1 class="font-heading font-black text-2xl">{{ 'customer.activate.title' | t }}</h1>
      {%- form 'activate_customer_password', class: 'space-y-4 mt-6' -%}
        {%- if form.errors -%}<div class="rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm p-4">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="cx-field"><input type="password" name="customer[password]" id="ActivatePassword" placeholder=" " required><label for="ActivatePassword">{{ 'forms.password' | t }}</label></div>
        <div class="cx-field"><input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" placeholder=" " required><label for="ActivatePasswordConfirm">{{ 'forms.password_confirm' | t }}</label></div>
        <button type="submit" name="activate" class="cx-btn w-full" style="width:100%"><span class="cx-btn-label">{{ 'customer.activate.submit' | t }}</span></button>
        <button type="submit" name="decline" class="w-full text-xs font-bold text-neutral-600 hover:text-red-600">{{ 'customer.activate.decline' | t }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "Reset / activate", "settings": [] }
{% endschema %}
