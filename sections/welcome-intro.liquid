<section style="position:relative;overflow:hidden;background:#fafaf8;padding:88px 0 96px;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(circle at 18% 60%,rgba(245,158,11,.07) 0%,transparent 52%),radial-gradient(circle at 82% 25%,rgba(217,119,6,.05) 0%,transparent 48%);pointer-events:none;"></div>
  <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:140px;height:3px;background:linear-gradient(90deg,transparent,#f59e0b,transparent);border-radius:0 0 6px 6px;"></div>
  <div style="max-width:820px;margin:0 auto;padding:0 28px;position:relative;z-index:1;text-align:center;">
    {%- if section.settings.eyebrow != blank -%}
    <div style="margin-bottom:18px;">
      <span style="display:inline-flex;align-items:center;gap:8px;color:#d97706;font-size:10px;font-weight:900;letter-spacing:.24em;text-transform:uppercase;">
        <span style="display:inline-block;width:32px;height:1.5px;background:linear-gradient(90deg,transparent,#f59e0b);border-radius:2px;"></span>
        {{ section.settings.eyebrow }}
        <span style="display:inline-block;width:32px;height:1.5px;background:linear-gradient(270deg,transparent,#f59e0b);border-radius:2px;"></span>
      </span>
    </div>
    {%- endif -%}
    <h2 style="font-size:clamp(1.9rem,4.5vw,3.1rem);font-weight:900;line-height:1.12;color:#0f0f0f;letter-spacing:-.025em;margin:0 0 22px;">
      {{ section.settings.heading }}<br>
      <span style="background:linear-gradient(90deg,#b45309,#f59e0b,#d97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">{{ section.settings.heading_highlight }}</span>
    </h2>
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:28px;">
      <div style="width:52px;height:3px;background:linear-gradient(90deg,#f59e0b,#d97706);border-radius:4px;"></div>
      <div style="width:9px;height:9px;border-radius:50%;background:#f59e0b;box-shadow:0 0 0 4px rgba(245,158,11,.18);"></div>
      <div style="width:52px;height:3px;background:linear-gradient(270deg,#f59e0b,#d97706);border-radius:4px;"></div>
    </div>
    <div style="font-size:15.5px;color:#555;line-height:1.85;margin:0 auto 52px;max-width:680px;">{{ section.settings.text }}</div>

    <div style="position:relative;background:#fff;border-radius:28px;padding:48px 52px;text-align:center;overflow:hidden;box-shadow:0 2px 4px rgba(0,0,0,.04),0 20px 56px -10px rgba(245,158,11,.18);border:1px solid rgba(245,158,11,.14);">
      <div style="display:inline-flex;align-items:center;justify-content:center;width:60px;height:60px;background:linear-gradient(135deg,#fef3c7,#fde68a);border-radius:20px;font-size:30px;margin-bottom:20px;">{{ section.settings.card_emoji }}</div>
      <h3 style="font-size:18px;font-weight:800;color:#0f0f0f;letter-spacing:-.01em;margin:0 0 14px;">{{ section.settings.card_heading }}</h3>
      <div style="font-size:14.5px;color:#6b7280;line-height:1.88;margin:0 auto;max-width:560px;">{{ section.settings.card_text }}</div>
      {%- if section.blocks.size > 0 -%}
      <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:30px;padding-top:26px;border-top:1px solid rgba(245,158,11,.14);">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }} style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#fffbeb,#fef3c7);border:1px solid rgba(245,158,11,.28);color:#92400e;font-size:11.5px;font-weight:700;padding:6px 14px;border-radius:999px;">{{ block.settings.label }}</span>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Welcome / SEO intro",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "India's Acrylic Destination" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to DisplaysKart —" },
    { "type": "text", "id": "heading_highlight", "label": "Highlighted heading", "default": "India's Trusted Acrylic Display Store" },
    { "type": "richtext", "id": "text", "label": "Intro text", "default": "<p>DisplaysKart is your one-stop manufacturer &amp; supplier for premium <strong>sign holders</strong>, acrylic photo frames, <strong>lockable donation boxes</strong>, brochure organizers, and riser stands engineered for retail stores, hotels, corporate offices, and exhibitions.</p>" },
    { "type": "header", "content": "Card" },
    { "type": "text", "id": "card_emoji", "label": "Emoji", "default": "💎" },
    { "type": "text", "id": "card_heading", "label": "Heading", "default": "Why Choose Acrylic Display Stands?" },
    { "type": "richtext", "id": "card_text", "label": "Text", "default": "<p>Crafted from virgin cast acrylic sheets, our display stands are <strong>lightweight</strong>, highly <strong>durable</strong>, <strong>shatter-resistant</strong>, and provide crystal clear 94%+ optical light transmission surpassing glass.</p>" }
  ],
  "blocks": [
    { "type": "pill", "name": "Feature pill", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "✓ 94% Clarity" } ] }
  ],
  "presets": [
    { "name": "Welcome / SEO intro", "blocks": [
      { "type": "pill", "settings": { "label": "✓ Virgin Cast Acrylic" } },
      { "type": "pill", "settings": { "label": "✓ Shatter-resistant" } },
      { "type": "pill", "settings": { "label": "✓ 94%+ Clarity" } }
    ] }
  ]
}
{% endschema %}
