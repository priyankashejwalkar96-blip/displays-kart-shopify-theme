<section class="py-14 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      {%- if section.settings.eyebrow != blank -%}<div class="text-xs uppercase font-extrabold text-red-600 tracking-widest mb-1">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="text-3xl sm:text-4xl font-black font-heading tracking-tight text-neutral-950 uppercase">{{ section.settings.heading | default: page.title }}</h1>
      <div class="w-16 h-1 bg-red-600 mx-auto mt-2 rounded-full"></div>
      {%- if section.settings.text != blank -%}<p class="text-sm text-gray-500 mt-4 max-w-2xl mx-auto">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="group block bg-[#faf9f6] rounded-2xl border border-gray-200 overflow-hidden hover:border-amber-500 transition" {{ block.shopify_attributes }}>
          <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover" loading="lazy" width="800" height="600">
            {%- else -%}{{ 'image' | placeholder_svg_tag: 'w-full h-full' }}{%- endif -%}
          </div>
          <div class="p-5">
            <h3 class="font-heading font-extrabold text-lg text-neutral-900 group-hover:text-red-600 transition">{{ block.settings.title }}</h3>
            <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">{{ block.settings.text }}</p>
            <span class="inline-block mt-3 text-xs font-bold text-red-600">{{ 'general.view_more' | t }} <i class="fa-solid fa-arrow-right"></i></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Applications",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHERE ACRYLIC WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Applications" },
    { "type": "textarea", "id": "text", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "application", "name": "Application",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Office Suppliers & Organizer" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Desk signs, name plates & organizers" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Applications", "blocks": [
    { "type": "application", "settings": { "title": "Office Suppliers & Organizer", "text": "Desk signs, name plates & organizers" } },
    { "type": "application", "settings": { "title": "NGO's & Government Organizations", "text": "Tamper-proof lockable charity boxes" } },
    { "type": "application", "settings": { "title": "Galleries and Museums", "text": "Floating certificate & art standoffs" } },
    { "type": "application", "settings": { "title": "Retail Displays for Shops", "text": "Pedestals, price tags & risers" } },
    { "type": "application", "settings": { "title": "Home Interior Photo Frames", "text": "Modern desktop & wall living decor" } }
  ] } ]
}
{% endschema %}
