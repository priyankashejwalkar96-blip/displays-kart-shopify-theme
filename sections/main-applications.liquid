<section class="py-14 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black font-heading text-neutral-950 tracking-tight uppercase">{{ section.settings.heading }}</h1>
      <p class="text-xs sm:text-sm text-neutral-700 font-medium mt-3 max-w-2xl mx-auto">{{ section.settings.text }}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14 max-w-6xl mx-auto mb-24">
      {%- for block in section.blocks -%}
        {%- if block.type == 'industry' -%}
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="group flex flex-col items-center text-center" {{ block.shopify_attributes }}>
            <div class="relative w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 overflow-hidden shadow-lg group-hover:shadow-2xl transition-all duration-500 ease-out group-hover:-translate-y-2.5 bg-neutral-100" style="clip-path: polygon(18% 0%, 82% 0%, 100% 18%, 100% 82%, 82% 100%, 18% 100%, 0% 82%, 0% 18%);">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" loading="lazy" width="700" height="700">
              {%- elsif block.settings.image_url != blank -%}
                <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" loading="lazy" width="700" height="700">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover' }}
              {%- endif -%}
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-8">
                <span class="text-white text-xs font-bold uppercase tracking-wider bg-red-600 px-4 py-1.5 rounded-full shadow-md">{{ section.settings.hover_label }}</span>
              </div>
            </div>
            <h3 class="mt-6 text-sm sm:text-base font-bold text-neutral-900 group-hover:text-red-600 transition-colors duration-300">{{ block.settings.title }}</h3>
            <p class="text-[11px] text-gray-500 mt-1 max-w-xs">{{ block.settings.text }}</p>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="max-w-6xl mx-auto mb-20 pt-10 border-t border-gray-100">
      <div class="text-center mb-8">
        <span class="text-xs font-extrabold text-red-600 uppercase tracking-widest">{{ section.settings.more_eyebrow }}</span>
        <h2 class="text-xl sm:text-2xl font-black font-heading text-neutral-900 mt-1">{{ section.settings.more_heading }}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
        {%- for block in section.blocks -%}
          {%- if block.type == 'vertical' -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="group p-6 rounded-2xl border border-gray-200 hover:border-red-500 hover:shadow-xl transition-all duration-300 bg-white block" {{ block.shopify_attributes }}>
              <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center text-xl mb-4 group-hover:bg-red-600 group-hover:text-white transition-colors duration-300"><i class="fa-solid {{ block.settings.icon }}"></i></div>
              <h4 class="font-bold text-sm text-neutral-900 group-hover:text-red-600 transition">{{ block.settings.title }}</h4>
              <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">{{ block.settings.text }}</p>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="max-w-5xl mx-auto pt-10 border-t border-gray-200">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-10 text-center">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="group flex flex-col items-center transition-transform hover:-translate-y-1" {{ block.shopify_attributes }}>
              <div class="w-14 h-14 flex items-center justify-center text-red-600 text-3xl mb-3 group-hover:scale-110 transition-transform duration-300"><i class="{{ block.settings.icon }} text-red-600"></i></div>
              <h4 class="font-black text-xs sm:text-sm font-heading tracking-wide uppercase text-neutral-900">{{ block.settings.title }}</h4>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Applications",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "INDUSTRIES WE SERVE" },
    { "type": "text", "id": "text", "label": "Subheading", "default": "Empowering Every Sector: Where Display Excellence Meets Diverse Industries." },
    { "type": "text", "id": "hover_label", "label": "Image hover label", "default": "Explore Displays" },
    { "type": "text", "id": "more_eyebrow", "label": "Second block eyebrow", "default": "MORE APPLICATIONS" },
    { "type": "text", "id": "more_heading", "label": "Second block heading", "default": "Explore Other Specialized Verticals" }
  ],
  "blocks": [
    { "type": "industry", "name": "Industry (octagon image)", "limit": 3, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_url", "label": "Or image URL" },
      { "type": "text", "id": "title", "label": "Title", "default": "Retail Displays for shops" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" } ] },
    { "type": "vertical", "name": "Vertical card", "limit": 3, "settings": [
      { "type": "text", "id": "icon", "label": "Font Awesome icon", "default": "fa-briefcase" },
      { "type": "text", "id": "title", "label": "Title", "default": "Office Suppliers & Organizer" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" } ] },
    { "type": "badge", "name": "Bottom badge", "limit": 4, "settings": [
      { "type": "text", "id": "icon", "label": "Icon classes", "default": "fa-solid fa-truck-fast" },
      { "type": "text", "id": "title", "label": "Title", "default": "FREE SHIPPING" } ] }
  ]
}
{% endschema %}
