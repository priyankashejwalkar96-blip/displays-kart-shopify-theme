<div class="max-w-md mx-auto px-4 py-20 text-center">
  <div class="border-2 border-neutral-900 inline-block px-3 py-1 text-2xl font-black tracking-tight text-neutral-900 font-heading">Displays <span class="bg-neutral-900 text-white px-1.5 ml-0.5">Kart</span></div>
  <p class="text-sm text-neutral-500 mt-6">{{ shop.password_message | default: 'This store is password protected.' }}</p>
  {%- form 'storefront_password', class: 'mt-6 space-y-4' -%}
    {{ form.errors | default_errors }}
    <div class="cx-field"><input type="password" name="password" id="Password" placeholder=" " required><label for="Password">{{ 'forms.password' | t }}</label></div>
    <button type="submit" class="cx-btn w-full" style="width:100%"><span class="cx-btn-label">{{ 'customer.login.submit' | t }}</span></button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
