<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-gray-200">
  <div class="grid lg:grid-cols-2 gap-10 items-center">
    <div class="relative rounded-3xl overflow-hidden bg-neutral-900 group aspect-video">
      {%- if section.settings.video_url != blank -%}
        {{ section.settings.video_url | video_tag: image_size: '1200x', loop: false, controls: true, class: 'w-full h-full object-cover' }}
      {%- elsif section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1200x', controls: true, class: 'w-full h-full object-cover' }}
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-700" loading="lazy" width="1200" height="675">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover' }}
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="text-xs uppercase font-extrabold text-red-600 tracking-widest mb-2">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-heading text-red-600 tracking-tight uppercase leading-tight mb-4">{{ section.settings.heading }}</h2>
      <div class="text-sm text-neutral-600 leading-relaxed mb-6 max-w-lg">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="inline-flex items-center gap-2.5 bg-[#d9534f] hover:bg-[#c9302c] active:scale-95 text-white font-black px-7 py-3.5 rounded-lg text-xs uppercase tracking-wider transition">{{ section.settings.button_label }} <i class="fa-solid fa-arrow-right"></i></a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="grid md:grid-cols-2 gap-6 mt-10">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }} class="bg-[#f0f0f0] hover:bg-[#e9e9e9] rounded-2xl p-6 sm:p-8 flex items-center justify-between gap-4 border border-gray-200/90 shadow-sm hover:shadow-md transition group">
        <div class="max-w-[60%]">
          <h3 class="font-black text-lg text-neutral-900 mb-2">{{ block.settings.title }}</h3>
          <p class="text-xs text-neutral-600 mb-4 leading-relaxed">{{ block.settings.text }}</p>
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="inline-flex items-center justify-center bg-[#d9534f] hover:bg-[#c9302c] active:scale-95 text-white font-bold text-xs px-6 py-2.5 rounded-md shadow-sm transition">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
        <div class="w-32 h-32 sm:w-40 sm:h-40 flex items-center justify-center shrink-0">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 350 }}" alt="{{ block.settings.title | escape }}" class="max-h-full max-w-full object-contain rounded-lg drop-shadow-md group-hover:scale-105 transition-transform duration-300" loading="lazy" width="160" height="160">
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Feature showcase",
  "tag": "div",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (Shopify-hosted)" },
    { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "image", "label": "Poster image (if no video)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TOP-TIER ACRYLIC SERIES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "PREMIUM SIGN HOLDER" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sleek and transparent, these durable acrylic holders professionally showcase menus or ads.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Acrylic Premium Sign Holder" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Enquire Now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [ { "name": "Feature showcase" } ]
}
{% endschema %}
