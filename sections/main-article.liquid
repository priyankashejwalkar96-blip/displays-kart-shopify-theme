<article class="py-8 lg:py-12 bg-[#faf9f6]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="hover:text-red-600">{{ 'general.home' | t }}</a><span>/</span>
      <a href="{{ blog.url }}" class="hover:text-red-600">{{ blog.title }}</a><span>/</span>
      <span class="text-neutral-900 font-semibold line-clamp-1">{{ article.title }}</span>
    </nav>

    {%- if article.tags.first -%}<span class="bl-tag" style="position:static;display:inline-flex"><i class="fa-solid fa-tag"></i>{{ article.tags.first }}</span>{%- endif -%}
    <h1 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl leading-[1.12] text-neutral-900 mt-4">{{ article.title }}</h1>
    <div class="bl-meta mt-5">
      <span class="bl-author"><span class="bl-av">{{ article.author | slice: 0 | upcase }}</span>{{ article.author }}</span><span class="bl-sep"></span>
      <span><i class="fa-regular fa-calendar"></i>{{ article.published_at | date: '%d %B %Y' }}</span><span class="bl-sep"></span>
      <span><i class="fa-regular fa-clock"></i>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} {{ 'blog.min_read' | t }}</span>
    </div>

    {%- if article.image -%}
      <div class="rounded-3xl overflow-hidden mt-8 border border-[#ece7df]">
        <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | default: article.title | escape }}" class="w-full h-auto" width="1400" height="{{ 1400 | divided_by: article.image.aspect_ratio | round }}" loading="eager">
      </div>
    {%- endif -%}

    <div class="in-card mt-8 rte text-[15.5px] text-neutral-700 leading-[1.9]">{{ article.content }}</div>

    <div class="flex flex-wrap items-center gap-3 mt-8 text-xs font-bold">
      <span class="text-neutral-500 uppercase tracking-wider">{{ 'blog.share' | t }}</span>
      <a target="_blank" rel="noopener" href="https://wa.me/?text={{ article.title | append: ' ' | append: shop.url | append: article.url | url_encode }}" class="cx-soc" style="border-color:#e5e5e5;color:#404040" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
      <a target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: article.url | url_encode }}" class="cx-soc" style="border-color:#e5e5e5;color:#404040" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
      <a target="_blank" rel="noopener" href="https://twitter.com/intent/tweet?url={{ shop.url | append: article.url | url_encode }}&text={{ article.title | url_encode }}" class="cx-soc" style="border-color:#e5e5e5;color:#404040" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
    </div>

    <div class="flex justify-between gap-4 mt-10 pt-6 border-t border-gray-200 text-sm font-bold">
      {%- if blog.previous_article -%}<a href="{{ blog.previous_article }}" class="hover:text-red-600"><i class="fa-solid fa-arrow-left mr-1"></i> {{ 'blog.previous' | t }}</a>{%- else -%}<span></span>{%- endif -%}
      {%- if blog.next_article -%}<a href="{{ blog.next_article }}" class="hover:text-red-600">{{ 'blog.next' | t }} <i class="fa-solid fa-arrow-right ml-1"></i></a>{%- endif -%}
    </div>

    {%- if blog.comments_enabled? -%}
      <div class="mt-12" id="comments">
        <h2 class="font-heading font-black text-2xl text-neutral-900 mb-6">{{ article.comments_count }} {{ 'blog.comments' | t }}</h2>
        {%- paginate article.comments by 10 -%}
          {%- for comment in article.comments -%}
            <div class="in-card mb-4" id="{{ comment.id }}">
              <div class="bl-author"><span class="bl-av">{{ comment.author | slice: 0 | upcase }}</span>{{ comment.author }} <span class="text-xs text-neutral-400 ml-2">{{ comment.created_at | date: '%d %b %Y' }}</span></div>
              <div class="mt-3 text-sm text-neutral-700">{{ comment.content }}</div>
            </div>
          {%- endfor -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}

        {%- form 'new_comment', article, class: 'in-card mt-6 space-y-4' -%}
          <h3 class="font-heading font-extrabold text-lg">{{ 'blog.leave_comment' | t }}</h3>
          {%- if form.errors -%}<div class="text-sm text-red-600">{{ form.errors | default_errors }}</div>{%- endif -%}
          {%- if form.posted_successfully? -%}<div class="text-sm text-emerald-600 font-semibold">{% if blog.moderated? %}{{ 'blog.comment_moderated' | t }}{% else %}{{ 'blog.comment_posted' | t }}{% endif %}</div>{%- endif -%}
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="cx-field"><input name="comment[author]" type="text" placeholder=" " required value="{{ form.author }}"><label>{{ 'forms.name' | t }}</label></div>
            <div class="cx-field"><input name="comment[email]" type="email" placeholder=" " required value="{{ form.email }}"><label>{{ 'forms.email' | t }}</label></div>
          </div>
          <div class="cx-field"><textarea name="comment[body]" rows="5" placeholder=" " required>{{ form.body }}</textarea><label>{{ 'forms.message' | t }}</label></div>
          <button type="submit" class="cx-btn"><span class="cx-btn-label">{{ 'blog.post_comment' | t }}</span></button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>
<script type="application/ld+json">{{ article | structured_data }}</script>

{% schema %}
{ "name": "Article page", "settings": [] }
{% endschema %}
