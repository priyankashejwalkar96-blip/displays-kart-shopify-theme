<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-gray-200">
  <div class="text-center mb-10">
    <h2 class="text-2xl sm:text-3xl font-black font-heading text-neutral-900 uppercase tracking-tight">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="text-sm text-gray-500 mt-3 max-w-2xl mx-auto">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {%- for block in section.blocks -%}
      <div class="bg-white rounded-xl border border-gray-200 p-6 flex gap-4" {{ block.shopify_attributes }}>
        <div class="w-12 h-12 rounded-2xl bg-[#fef7ee] text-amber-600 flex items-center justify-center text-xl shrink-0"><i class="fa-solid {{ block.settings.icon }}"></i></div>
        <div>
          <h3 class="font-bold text-sm text-neutral-900">{{ block.settings.title }}</h3>
          <p class="text-xs text-gray-500 mt-1 leading-relaxed">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Who we serve",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who We Serve" },
    { "type": "text", "id": "text", "label": "Intro", "default": "DisplaysKart products are trusted by businesses and institutions across India, including:" }
  ],
  "blocks": [
    {
      "type": "item", "name": "Audience",
      "settings": [
        { "type": "text", "id": "icon", "label": "Font Awesome icon class", "default": "fa-store" },
        { "type": "text", "id": "title", "label": "Title", "default": "Retail Stores" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Product signs, price holders, display stands and acrylic risers." }
      ]
    }
  ],
  "presets": [
    { "name": "Who we serve", "blocks": [
      { "type": "item", "settings": { "icon": "fa-store", "title": "Retail Stores", "text": "Product signs, price holders, display stands and acrylic risers." } },
      { "type": "item", "settings": { "icon": "fa-utensils", "title": "Hotels & Restaurants", "text": "Menu holders, napkin holders, amenity caddies and name plates." } },
      { "type": "item", "settings": { "icon": "fa-briefcase", "title": "Offices", "text": "Name plates, brochure holders and desk sign holders." } },
      { "type": "item", "settings": { "icon": "fa-hand-holding-heart", "title": "NGOs & Temples", "text": "Lockable donation and suggestion boxes." } },
      { "type": "item", "settings": { "icon": "fa-palette", "title": "Galleries & Museums", "text": "Wall-mount frames and display cases for art and collectibles." } },
      { "type": "item", "settings": { "icon": "fa-calendar-check", "title": "Exhibitions", "text": "Acrylic display stands for events and trade shows across India." } }
    ] }
  ]
}
{% endschema %}
