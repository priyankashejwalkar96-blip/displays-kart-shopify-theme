{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="text-center mb-8">
    <span class="text-xs font-bold text-amber-600 uppercase tracking-widest">{{ 'products.you_may_also_like' | t }}</span>
    <h2 class="font-heading font-black text-3xl text-neutral-900 mt-2">{{ 'products.related' | t }}</h2>
  </div>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    {%- for product in recommendations.products -%}
      {% render 'product-card', product: product %}
    {%- endfor -%}
  </div>
{%- endif -%}
{% schema %}
{ "name": "Product recommendations", "settings": [] }
{% endschema %}
