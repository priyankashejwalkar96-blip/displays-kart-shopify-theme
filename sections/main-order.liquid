<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <a href="{{ routes.account_url }}" class="text-xs font-bold text-neutral-600 hover:text-red-600"><i class="fa-solid fa-arrow-left mr-1"></i>{{ 'customer.back_to_account' | t }}</a>
  <h1 class="font-heading font-black text-3xl text-neutral-900 mt-3">{{ 'customer.order' | t }} {{ order.name }}</h1>
  <p class="text-sm text-neutral-500 mt-1">{{ order.created_at | date: '%d %B %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
  {%- if order.cancelled -%}<p class="text-sm text-red-600 font-bold mt-2">{{ 'customer.cancelled' | t }}: {{ order.cancelled_at | date: '%d %b %Y' }}</p>{%- endif -%}

  <div class="grid lg:grid-cols-12 gap-6 mt-6">
    <div class="lg:col-span-8 in-card">
      <table class="pd-spec w-full">
        <thead><tr class="text-xs uppercase text-neutral-500 text-left"><th class="!w-auto">{{ 'customer.product' | t }}</th><th class="!w-auto">{{ 'products.quantity' | t }}</th><th class="!w-auto">{{ 'cart.total' | t }}</th></tr></thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>{{ line_item.title }}{% if line_item.sku != blank %}<br><span class="text-[11px] text-neutral-400">SKU: {{ line_item.sku }}</span>{% endif %}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot class="text-sm">
          <tr><th class="!w-auto" colspan="2">{{ 'cart.subtotal' | t }}</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for shipping_method in order.shipping_methods -%}<tr><th class="!w-auto" colspan="2">{{ 'cart.shipping' | t }} ({{ shipping_method.title }})</th><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
          {%- for tax_line in order.tax_lines -%}<tr><th class="!w-auto" colspan="2">{{ tax_line.title }}</th><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
          <tr><th class="!w-auto" colspan="2">{{ 'cart.total' | t }}</th><td class="font-black text-red-600">{{ order.total_price | money }}</td></tr>
        </tfoot>
      </table>
    </div>
    <aside class="lg:col-span-4 space-y-4">
      <div class="in-card"><h2 class="font-heading font-extrabold text-sm uppercase tracking-wider mb-2">{{ 'customer.billing' | t }}</h2><div class="text-sm text-neutral-600">{{ order.billing_address | format_address }}</div></div>
      <div class="in-card"><h2 class="font-heading font-extrabold text-sm uppercase tracking-wider mb-2">{{ 'customer.shipping' | t }}</h2><div class="text-sm text-neutral-600">{{ order.shipping_address | format_address }}</div></div>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "Order", "settings": [] }
{% endschema %}
