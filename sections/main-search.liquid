<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <h1 class="font-heading font-black text-3xl text-neutral-900 uppercase tracking-tight">{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="relative mt-6 max-w-2xl">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" class="w-full bg-white border border-gray-300 rounded-full py-3 pl-6 pr-14 text-sm focus:outline-none focus:border-neutral-900">
    <button type="submit" class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-black" aria-label="{{ 'general.search' | t }}"><i class="fa-solid fa-magnifying-glass"></i></button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 16 -%}
      <p class="text-sm text-gray-500 mt-6 mb-6">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results.size > 0 -%}
        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- elsif item.object_type == 'article' -%}
              {% render 'article-card', article: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-amber-500 transition">
                <span class="text-[10px] uppercase font-bold text-red-600 tracking-wider">{{ item.object_type }}</span>
                <h3 class="font-bold text-sm mt-1">{{ item.title }}</h3>
                <p class="text-xs text-gray-500 mt-2">{{ item.content | strip_html | truncate: 100 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="text-center py-16 bg-white border border-dashed border-gray-300 rounded-2xl">
          <i class="fa-regular fa-face-frown text-3xl text-gray-300 mb-3"></i>
          <p class="font-bold">{{ 'search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search page", "settings": [] }
{% endschema %}
