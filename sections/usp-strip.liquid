<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-8 relative z-20 mb-8">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {%- for block in section.blocks -%}
      <div class="bg-white p-5 rounded-2xl border border-gray-200/90 shadow-md flex items-center gap-4" {{ block.shopify_attributes }}>
        <div class="w-12 h-12 rounded-2xl bg-[#fef7ee] text-amber-600 flex items-center justify-center text-xl shrink-0">
          <i class="fa-solid {{ block.settings.icon | default: 'fa-truck-fast' }}"></i>
        </div>
        <div>
          <h4 class="font-bold text-xs sm:text-sm text-neutral-900">{{ block.settings.title }}</h4>
          <p class="text-[11px] text-gray-500 mt-0.5">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "USP strip",
  "tag": "div",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "usp",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Font Awesome icon class", "info": "e.g. fa-truck-fast, fa-shield-halved, fa-headset, fa-percent", "default": "fa-truck-fast" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping above ₹1000" },
        { "type": "text", "id": "text", "label": "Text", "default": "Safely boxed pan-India dispatch" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP strip",
      "blocks": [
        { "type": "usp", "settings": { "icon": "fa-truck-fast", "title": "Free shipping above ₹1000", "text": "Safely boxed pan-India dispatch" } },
        { "type": "usp", "settings": { "icon": "fa-shield-halved", "title": "Secure payment", "text": "100% Protected Razorpay checkout" } },
        { "type": "usp", "settings": { "icon": "fa-headset", "title": "Help center", "text": "Call/WhatsApp: +91 79000 54449" } },
        { "type": "usp", "settings": { "icon": "fa-percent", "title": "5% discount on bulk", "text": "Automatic cart tier discounts" } }
      ]
    }
  ]
}
{% endschema %}
