{%- liquid
  assign col = section.settings.collection
  assign limit = section.settings.products_to_show
  assign cols = section.settings.columns_desktop
-%}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-gray-200">
  {%- if section.settings.style == 'centered' -%}
    <div class="text-center mb-10">
      {%- if section.settings.eyebrow != blank -%}<div class="text-xs uppercase font-extrabold text-red-600 tracking-widest mb-1">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="text-3xl sm:text-4xl font-black font-heading tracking-tight text-neutral-950 uppercase">{{ section.settings.heading }}</h2>
      <div class="w-16 h-1 bg-red-600 mx-auto mt-2 rounded-full"></div>
    </div>
  {%- else -%}
    <div class="flex justify-between items-baseline mb-8">
      <h2 class="text-2xl sm:text-3xl font-black font-heading text-neutral-900 uppercase tracking-tight">{{ section.settings.heading }}</h2>
      {%- if col != blank and section.settings.show_view_all -%}
        <a href="{{ col.url }}" class="text-xs font-bold text-neutral-700 hover:text-red-600 transition underline">{{ 'general.view_more' | t }} &gt;</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if col != blank and col.products.size > 0 -%}
    <div class="grid grid-cols-2 {% if cols == '5' %}md:grid-cols-3 lg:grid-cols-5{% elsif cols == '3' %}lg:grid-cols-3{% else %}md:grid-cols-3 lg:grid-cols-4{% endif %} gap-4 sm:gap-6">
      {%- for product in col.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {%- for i in (1..4) -%}
        <div class="rounded-xl border border-gray-200 bg-white p-4"><div class="aspect-square bg-gray-50 rounded-lg">{{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full' }}</div></div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.style == 'centered' and col != blank and section.settings.show_view_all -%}
    <div class="text-center mt-8"><a href="{{ col.url }}" class="inline-block bg-neutral-900 hover:bg-red-600 text-white font-bold text-xs px-8 py-3 rounded-lg transition uppercase tracking-wider">{{ 'general.view_all' | t }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "style", "label": "Heading style", "default": "left", "options": [ { "value": "left", "label": "Left + View more link" }, { "value": "centered", "label": "Centered with eyebrow" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (centered style)", "default": "FEATURED PRODUCTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Acrylic Sign Holder" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "columns_desktop", "label": "Columns (desktop)", "default": "4", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" } ] },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view-all link", "default": true }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
