{%- if section.settings.show -%}
<div id="top-announcement-bar" class="dk-announce" style="background:linear-gradient(90deg,#0f0f0f 0%,#1a1a1a 30%,#111 60%,#0f0f0f 100%);position:sticky;top:0;z-index:60;overflow:hidden;height:40px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid rgba(245,158,11,.25);">
  <div style="position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(245,158,11,.07) 50%,transparent 60%);animation:topbar-shimmer 3s linear infinite;pointer-events:none;"></div>

  {%- if section.settings.badge != blank -%}
  <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
    <span style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#0f0f0f;font-size:10px;font-weight:800;letter-spacing:.08em;padding:2px 8px;border-radius:20px;text-transform:uppercase;white-space:nowrap;">{{ section.settings.badge }}</span>
  </div>
  {%- endif -%}

  <div style="flex:1;overflow:hidden;position:relative;margin:0 16px;">
    <div id="topbar-marquee" style="display:flex;width:max-content;white-space:nowrap;animation:topbar-scroll {{ section.settings.speed }}s linear infinite;will-change:transform;">
      {%- for i in (1..2) -%}
        <div style="display:flex;gap:48px;padding-right:48px;" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }} style="color:#f5f5f5;font-size:11.5px;font-weight:600;letter-spacing:.03em;display:flex;align-items:center;gap:8px;">
              <span style="color:#f59e0b">✦</span>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
    <div style="position:absolute;top:0;left:0;width:48px;height:100%;background:linear-gradient(90deg,#111,transparent);pointer-events:none;"></div>
    <div style="position:absolute;top:0;right:0;width:48px;height:100%;background:linear-gradient(270deg,#111,transparent);pointer-events:none;"></div>
  </div>

  <button type="button" data-announce-close aria-label="{{ 'general.close' | t }}" style="flex-shrink:0;background:none;border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.5);width:22px;height:22px;border-radius:50%;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;">✕</button>
</div>
<style>
  @keyframes topbar-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
  @keyframes topbar-shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(200%)}}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "badge", "label": "Left badge", "default": "🏷️ Exclusive Offers" },
    { "type": "range", "id": "speed", "label": "Scroll duration (seconds)", "min": 10, "max": 80, "step": 2, "default": 28 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free Shipping on orders above ₹1,000" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free Shipping on orders above ₹1,000" } },
        { "type": "message", "settings": { "text": "5% Discount on Bulk Orders" } },
        { "type": "message", "settings": { "text": "100% Genuine Cast Acrylic" } },
        { "type": "message", "settings": { "text": "Direct Manufacturer & Importer — Best Prices Guaranteed" } },
        { "type": "message", "settings": { "text": "Pan-India Delivery" } }
      ]
    }
  ]
}
{% endschema %}
