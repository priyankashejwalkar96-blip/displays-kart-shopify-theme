<div class="max-w-md mx-auto px-4 py-12">
  <div class="pd-card p-6 sm:p-8">
    <h1 class="font-heading font-black text-2xl text-neutral-900">{{ 'customer.register.title' | t }}</h1>
    <p class="text-sm text-neutral-500 mt-1 mb-6">{{ 'customer.register.subtitle' | t }}</p>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'space-y-4' -%}
      {%- if form.errors -%}<div class="rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm p-4" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="grid grid-cols-2 gap-3">
        <div class="cx-field"><input type="text" name="customer[first_name]" id="RegisterFirstName" placeholder=" " autocomplete="given-name" value="{{ form.first_name }}"><label for="RegisterFirstName">{{ 'forms.first_name' | t }}</label></div>
        <div class="cx-field"><input type="text" name="customer[last_name]" id="RegisterLastName" placeholder=" " autocomplete="family-name" value="{{ form.last_name }}"><label for="RegisterLastName">{{ 'forms.last_name' | t }}</label></div>
      </div>
      <div class="cx-field"><input type="email" name="customer[email]" id="RegisterEmail" placeholder=" " autocomplete="email" value="{{ form.email }}" required><label for="RegisterEmail">{{ 'forms.email' | t }}</label></div>
      <div class="cx-field"><input type="password" name="customer[password]" id="RegisterPassword" placeholder=" " autocomplete="new-password" required><label for="RegisterPassword">{{ 'forms.password' | t }}</label></div>
      <button type="submit" class="cx-btn w-full" style="width:100%"><span class="cx-btn-label">{{ 'customer.register.submit' | t }}</span></button>
    {%- endform -%}
    <p class="text-sm text-neutral-600 mt-6 text-center">{{ 'customer.register.have_account' | t }} <a href="{{ routes.account_login_url }}" class="font-bold text-red-600">{{ 'customer.login.title' | t }}</a></p>
  </div>
</div>
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
