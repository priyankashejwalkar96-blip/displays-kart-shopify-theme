<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <a href="{{ routes.account_url }}" class="text-xs font-bold text-neutral-600 hover:text-red-600"><i class="fa-solid fa-arrow-left mr-1"></i>{{ 'customer.back_to_account' | t }}</a>
  <h1 class="font-heading font-black text-3xl text-neutral-900 mt-3 mb-6">{{ 'customer.addresses' | t }}</h1>

  <div class="grid md:grid-cols-2 gap-5">
    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div class="in-card">
          {%- if address == customer.default_address -%}<span class="pd-chip mb-2">{{ 'customer.default' | t }}</span>{%- endif -%}
          <div class="text-sm text-neutral-700">{{ address | format_address }}</div>
          <div class="flex gap-4 mt-4 text-xs font-bold">
            <button type="button" class="text-neutral-700 hover:text-red-600" data-address-toggle="edit-{{ address.id }}">{{ 'customer.edit' | t }}</button>
            <button type="button" class="text-red-600 hover:underline" data-address-delete="{{ address.url }}" data-confirm="{{ 'customer.confirm_delete' | t | escape }}">{{ 'cart.remove' | t }}</button>
          </div>
          <div id="edit-{{ address.id }}" class="hidden mt-4">
            {%- form 'customer_address', address, class: 'space-y-3' -%}
              {% render 'address-fields', address: address, uid: address.id %}
              <button type="submit" class="cx-btn"><span class="cx-btn-label">{{ 'customer.save' | t }}</span></button>
            {%- endform -%}
          </div>
        </div>
      {%- endfor -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}

    <div class="in-card">
      <h2 class="font-heading font-extrabold text-lg mb-3">{{ 'customer.add_address' | t }}</h2>
      {%- form 'customer_address', customer.new_address, class: 'space-y-3' -%}
        {% render 'address-fields', address: form, uid: 'new' %}
        <button type="submit" class="cx-btn"><span class="cx-btn-label">{{ 'customer.add_address' | t }}</span></button>
      {%- endform -%}
    </div>
  </div>
</div>
<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
<script>document.querySelectorAll('[data-address-delete]').forEach(function(b){b.addEventListener('click',function(){if(confirm(b.dataset.confirm)){Shopify.postLink(b.dataset.addressDelete,{parameters:{_method:'delete'}});}});});
document.querySelectorAll('[data-address-toggle]').forEach(function(b){b.addEventListener('click',function(){document.getElementById(b.dataset.addressToggle).classList.toggle('hidden');});});</script>
{% schema %}
{ "name": "Addresses", "settings": [] }
{% endschema %}
