<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#171717">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    :root {
      --dk-amber: {{ settings.color_accent | default: '#f59e0b' }};
      --dk-red: {{ settings.color_primary | default: '#d9534f' }};
    }
  </style>

  <script>
    window.theme = {
      moneyFormat: {{ shop.money_format | json }},
      cartUrl: {{ routes.cart_url | json }},
      cartAddUrl: {{ routes.cart_add_url | json }},
      cartChangeUrl: {{ routes.cart_change_url | json }},
      cartJsUrl: {{ routes.cart_url | append: '.js' | json }},
      strings: {
        added: {{ 'cart.added' | t | json }},
        addToCart: {{ 'products.add_to_cart' | t | json }},
        viewDetails: {{ 'products.view_full_details' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }},
        wishlistAdded: {{ 'wishlist.added' | t | json }},
        wishlistRemoved: {{ 'wishlist.removed' | t | json }}
      }
    };
  </script>
  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }} bg-[#fcfbf9] text-neutral-800 antialiased selection:bg-amber-500 selection:text-white">
  <a class="sr-only focus:not-sr-only" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div id="dk-prog"></div>
  <button id="dk-top" aria-label="{{ 'general.back_to_top' | t }}"><i class="fa-solid fa-chevron-up"></i></button>
  <div id="dk-toast" role="status"><i class="fa-solid fa-circle-check"></i> <span></span></div>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
